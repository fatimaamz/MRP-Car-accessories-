<odoo>
  <record id="view_sale_order_filter_team" model="ir.ui.view">
    <field name="name">sale.order.filter.team</field>
    <field name="model">sale.order</field>
    <field name="arch" type="xml">
      <search string="Filtre Stats Commerciales">
        <filter string="7 derniers jours" name="last_7_days"
                domain="[('date_order','>=',(context_today() - relativedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
        <group expand="0" string="Groupe par">
          <filter string="Équipe commerciale" name="group_team" domain="[]" context="{'group_by':'team_id'}"/>
          <filter string="Date" name="group_date" domain="[]" context="{'group_by':'date_order'}"/>
        </group>
      </search>
    </field>
  </record>
</odoo>
