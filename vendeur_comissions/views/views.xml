<odoo>


    <record id="crm_team_kanban_last_7_days" model="ir.ui.view">
        <field name="name">crm.team.kanban.last_7_days</field>
        <field name="model">crm.team</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_card">
                            <div class="o_kanban_card_header">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_card_content">
                                <field name="last_7_days_chart" widget="dashboard_graph" t-att-graph_type="'bar'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="crm_team_action_last_7_days" model="ir.actions.act_window">
    <field name="name">Stats sur 7 jours</field>
    <field name="res_model">crm.team</field>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="crm_team_kanban_last_7_days"/>
</record>
    <menuitem id="menu_crm_team_last_7_days"
          name="Stats Hebdo"
          parent="crm.crm_menu_sales"
          action="crm_team_action_last_7_days"/>

    
    <record id="view_sale_order" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="type_client" invisible="1"/>
                <field name="installation" invisible="type_client != 'concessionnaires_programme_nationaux'"/>
                    
                <field name="commission_pool" />
               <field name="individual_commissions"/>
            </xpath>
        </field>
    </record>

  <record id="view_tree_sale_order" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">

            <xpath expr="//tree" position="inside">
                <field name="commission_pool" sum="Total Commission Pool" options="{'currency_field': 'currency_id'}"/>
               <field name="individual_commissions"/>
            </xpath>
             <xpath expr="//tree//field[@name='partner_id']" position="after">
                 <field name="partner_shipping_id" string="Dealership"/>
             </xpath>
        </field>
    </record>
    
    
 <record id="view_form_crm_lead" model="ir.ui.view">
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form" />
        <field name="arch" type="xml">

           <field name="company_id" position="after">
                <label for="weekly_target"/>
                <div class="o_row">
                    <field name="weekly_target" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                    <span class="flex-grow-1">/ Semaine</span>
                </div>
            </field>
        </field>
    </record>

      

        <!-- Vue de liste pour afficher les jours travaillés -->
        <record id="view_sales_rep_attendance_tree" model="ir.ui.view">
            <field name="name">sales.rep.attendance.tree</field>
            <field name="model">sales.rep.attendance</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="team_id"/>
                    <field name="sales_rep_id"/>
                    <field name="week_start_date"/>
                    <field name="days_worked"/>
                </tree>
            </field>
        </record>
    <record id="view_sales_rep_attendance_form" model="ir.ui.view">
    <field name="name">sales.rep.attendance.form</field>
    <field name="model">sales.rep.attendance</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        
                        <field name="team_id"/>
                        <field name="sales_rep_id"/>
                    </group>
                    <group>
                        <field name="week_start_date"/>
                        <field name="days_worked"/>
                        <field name="allowed_sales_reps"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <!-- Action pour ouvrir la vue de liste des jours travaillés -->
        <record id="action_sales_rep_attendance" model="ir.actions.act_window">
            <field name="name">Jours Travaillés des Vendeurs</field>
            <field name="res_model">sales.rep.attendance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_sales_rep_attendance_tree"/>
        </record>
        <menuitem id="menu_sales_rep_attendance" name="Jours Travaillés/Vendeurs"
                  parent="sale.menu_sale_config" action="action_sales_rep_attendance"/>
   
</odoo>



  



