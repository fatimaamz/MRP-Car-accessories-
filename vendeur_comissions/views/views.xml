<odoo>
    <record id="view_sale_order" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="commission_pool"/>
               <field name="individual_commissions"/>
            </xpath>
        </field>
    </record>

  <record id="view_tree_sale_order" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">

            <xpath expr="//tree" position="inside">
                <field name="commission_pool"/>
               <field name="individual_commissions"/>
            </xpath>
        </field>
    </record>
    
    
 <record id="view_form_crm_lead" model="ir.ui.view">
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form" />
        <field name="arch" type="xml">

           <field name="company_id" position="after">
                <label for="weekly_target"/>
                <div class="o_row">
                    <field name="weekly_target" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                    <span class="flex-grow-1">/ Semaine</span>
                </div>
            </field>
        </field>
    </record>

      

        <!-- Vue de liste pour afficher les jours travaillés -->
        <record id="view_sales_rep_attendance_tree" model="ir.ui.view">
            <field name="name">sales.rep.attendance.tree</field>
            <field name="model">sales.rep.attendance</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="team_id"/>
                    <field name="sales_rep_id"/>
                    <field name="week_start_date"/>
                    <field name="days_worked"/>
                </tree>
            </field>
        </record>
    <record id="view_sales_rep_attendance_form" model="ir.ui.view">
    <field name="name">sales.rep.attendance.form</field>
    <field name="model">sales.rep.attendance</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        
                        <field name="team_id"/>
                        <field name="sales_rep_id"/>
                    </group>
                    <group>
                        <field name="week_start_date"/>
                        <field name="days_worked"/>
                        <field name="allowed_sales_reps"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <!-- Action pour ouvrir la vue de liste des jours travaillés -->
        <record id="action_sales_rep_attendance" model="ir.actions.act_window">
            <field name="name">Jours Travaillés des Vendeurs</field>
            <field name="res_model">sales.rep.attendance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_sales_rep_attendance_tree"/>
        </record>
        <menuitem id="menu_sales_rep_attendance" name="Jours Travaillés/Vendeurs"
                  parent="sale.menu_sale_config" action="action_sales_rep_attendance"/>
   
</odoo>



  



