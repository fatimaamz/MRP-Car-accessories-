<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sale_product_configurator_custom" inherit_id="saleProductConfigurator.productList">
        <xpath expr="//table" position="before">
            <div class="mt-3 mb-3">
                <label>
                    <input type="radio" name="color_option" value="paint_match"
                           t-model="state.color_option"
                           t-on-change="onColorOptionChange"/>
                    Paint Match
                </label>
                <label>
                    <input type="radio" name="color_option" value="carbon"
                           t-model="state.color_option"
                           t-on-change="onColorOptionChange"/>
                    Carbon
                </label>
            </div>
        </xpath>
        <xpath expr="//tbody/tr[Product]" position="replace">
            <tr t-foreach="getFilteredProducts()" t-as="product" t-key="product.product_tmpl_id">
                <Product t-props="product" optional="this.props.areProductsOptional"/>
            </tr>
        </xpath>
    </template>
</odoo>
