<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_deliveryslip_document_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@class='col-auto']" position="before">
            
                <div ct-if="o.numero_commande" class="col-auto">
                    <strong>Numéro de commande :</strong>
                    <p t-field="o.numero_commande"/>
                </div>
                <div t-if="o.numero_suivi" class="col-auto">
                    <strong>Numéro de suivi :</strong>
                    <p t-field="o.numero_suivi"/>
                </div>
        
        </xpath>

        <xpath expr="//table[@name='stock_move_table']//thead[1]//tr[1]//th[@name='th_sm_product']" position="after">
            <th name="th_sm_image">
                <strong>Image</strong>
            </th>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']//tbody[1]//tr[1]//td[1]" position="after">
            <td class="text-right">
                <img t-if="move.image_128" t-att-src="image_data_uri(move.image_128)" style="width: 90%"/>
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']//tbody[1]//tr[1]//td[3]//span[1]" position="replace">
           
                  <span t-field="move.product_uom_qty" t-options='{"widget": "float", "precision": 0}'/>
                
        </xpath>

        <xpath expr="//table[@name='stock_move_table']//tbody[1]//tr[1]//td[4]//span[1]" position="replace">

          
                            <span t-field="move.quantity" t-options='{"widget": "float", "precision": 0}'/>
                    
        </xpath>

        
    </template>
</odoo>
