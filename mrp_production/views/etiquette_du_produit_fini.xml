<odoo>
    <data>
        <template id="label_production_view_pdf_custom" inherit_id="mrp.label_production_view_pdf">
            <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
                <t t-call="web.basic_layout">
                    <!-- Outer Container -->
                    <div style="width: 100mm; height: 150mm; border: 1px solid black; padding: 5mm; border-radius: 12px; overflow: hidden;">
                        
                        <!-- Header Section -->
                        <div style="width: 100%; height: 40mm; background-color: black; color: white; text-align: center; position: relative; border-radius: 12px 12px 0 0;">
                            <!-- DesignerTrim Logo -->
                            <div style="font-size: 16px; font-weight: bold; line-height: 40mm;">DESIGNERTRIM</div>
                            
                            <!-- QR Code -->
                            <img t-att-src="docs.product_id.qr_code_uploaded" 
                                 style="width: 25mm; height: 25mm; position: absolute; top: 7mm; right: 7mm; background-color: white; padding: 3px; border-radius: 5px;" />
                        </div>

                        <!-- Product Details Section -->
                        <div style="padding: 5mm; text-align: left;">
                            <!-- Product Name and Details -->
                            <p style="margin: 0; font-size: 14px;">
                                <strong t-field="docs.product_id.display_name"/> <!-- Product Name -->
                            </p>
                            <p style="margin: 0; font-size: 12px;">
                                <span><strong>Rocker Kit</strong></span> | 
                                <span><strong>Color:</strong> <t t-esc="docs.color or 'N/A'"/></span>
                            </p>
                        </div>

                        <!-- Product Image Section -->
                        <div style="width: 100%; height: 50mm; text-align: center; margin: 5mm 0;">
                            <img t-att-src="image_data_uri(docs.product_image)" 
                                 style="max-width: 100%; height: 100%; object-fit: contain; border: 1px solid black; border-radius: 5px;" />
                        </div>

                        <!-- Part and Barcode Section -->
                        <div style="text-align: center; margin-top: 5mm;">
                            <!-- Part Number -->
                            <p style="margin: 0; font-size: 12px;">
                                <strong>PART#:</strong> <span t-field="docs.product_id.default_code" />
                            </p>
                            
                            <!-- Barcode -->
                            <div style="margin-top: 3mm;">
                                <t t-if="docs.product_id.tracking != 'none' and docs.lot_name">
                                    <div t-field="docs.lot_name" t-options="{'widget': 'barcode', 'img_style': 'width:100%; height:30px'}" />
                                </t>
                                <t t-elif="docs.product_id.barcode">
                                    <div t-field="docs.product_id.barcode" t-options="{'widget': 'barcode', 'img_style': 'width:100%; height:30px'}" />
                                </t>
                                <t t-else="">
                                    <span>No barcode available</span>
                                </t>
                            </div>
                        </div>

                      
                        <div style="text-align: center; margin-top: 5mm; font-size: 12px; font-weight: bold;">
                            <t t-esc="docs.product_id.barcode or ''" />
                        </div>
                        
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
