<odoo>
    <!--test -->
    <data>
        <template id="label_production_view_pdf_custom" inherit_id="mrp.label_production_view_pdf">
            <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
                <t t-call="web.basic_layout">
                    <!-- Outer Container -->
                    <div style="width: 100mm; height: 170mm; border: 1px solid black; padding: 5mm; border-radius: 12px; overflow: hidden;">
                        
                        <!-- Header Section -->
                        <div style="width: 100%; height: 40mm; background-color: black; color: white; text-align: left; position: relative; border-radius: 12px 12px 0 0;">
                            <!-- DesignerTrim Logo -->
                            <div style="font-size: 16px; font-weight: bold; line-height: 40mm;"><span t-field="docs.sale_order_partner_id.name" /></div>
                            
                            <!-- QR Code -->
                             <img t-att-src="image_data_uri(docs.product_id.qr_code_uploaded)" 
                                 style="width: 25mm; height: 25mm; position: absolute; top: 7mm; right: 7mm; background-color: white; padding: 3px; border-radius: 5px;" />
                        </div>

                        <!-- Product Details Section -->
                        <div style="padding: 5mm; text-align: left;">
                            <!-- Product Name and Details -->
                            <p style="margin: 0; font-size: 14px;">
                                <strong t-field="docs.product_id.display_name"/> <!-- Product Name -->
                            </p>
                            <p style="margin: 0; font-size: 12px;">
                                <span><strong>Type de produit : </strong><t t-esc="docs.product_id.detailed_type"/></span> <br/>
                               <span><strong>Marque : </strong><t t-esc="docs.product_variant_ids[0].name"/></span> <br/>
                                <span><strong>Année :</strong><t t-esc="docs.years or ''"/></span><b/>
                                <span><strong>Model : </strong><t t-esc="docs.product_variant_ids[1].name"/></span><br/>
                                <span><strong>Couleur :</strong> <t t-esc="docs.interior_color or ''"/></span>
                            </p>
                        </div>

                        <!-- Product Image Section -->
                        <div style="width: 100%; height: 50mm; text-align: center; margin: 5mm 0;border: 2px solid gray;">
                            <img t-att-src="image_data_uri(docs.selected_image)" 
                                 style="max-width: 100%; height: 100%; object-fit: contain; border: 1px solid black; border-radius: 5px;" />
                        </div>

                        <!-- Part and Barcode Section -->
                        <div style="text-align: center; margin-top: 5mm;">
                            <!-- Part Number -->
                            <p style="margin: 0; font-size: 12px;border: 2px solid gray;">
                                <strong>PART#:</strong> <span t-field="docs.product_id.name" /><span t-field="docs.interior_color" /><span t-field="docs.insert_color" />
                            </p>
                            
                            <!-- Barcode -->
                            <div style="margin-top: 3mm;">
                                <t t-if="docs.product_id.tracking != 'none' and docs.lot_name">
                                    <div t-field="docs.lot_name" t-options="{'widget': 'barcode', 'img_style': 'width:100%; height:30px'}" />
                                </t>
                                <t t-elif="docs.product_id.barcode">
                                    <div t-field="docs.product_id.barcode" t-options="{'widget': 'barcode', 'img_style': 'width:100%; height:30px'}" />
                                </t>
                                <t t-else="">
                                    <span>No barcode available</span>
                                </t>
                            </div>
                        </div>

                      
                        <div style="text-align: center; margin-top: 5mm; font-size: 12px; font-weight: bold;">
                            <t t-esc="docs.product_id.barcode or ''" />
                        </div>
                        
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
