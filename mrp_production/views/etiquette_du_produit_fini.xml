<odoo>
    <data>
        <!-- Héritage du modèle existant -->
        <template id="label_production_view_pdf_custom" inherit_id="mrp.label_production_view_pdf">
            <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
                <t t-call="web.basic_layout">
                  
                  
                <t t-set="nRows" t-value="12"/>
                    <t t-set="nCols" t-value="4"/>
                    <t t-set="uom_categ_unit" t-value="env.ref('uom.product_uom_categ_unit')"/>

                    <t t-set="move_lines"
                       t-value="docs.move_finished_ids.move_line_ids.filtered(lambda ml: ml.move_id.production_id.state == 'done' and ml.state == 'done' and ml.quantity)"/>
                    <t t-set="move_line_qtys" t-value="[]"/>
                    <t t-foreach="move_lines" t-as="move_line">
                        <t t-if="move_line.product_uom_id.category_id == uom_categ_unit">
                            <t t-set="move_line_qtys" t-value="move_line_qtys + [int(move_line.quantity)]"/>
                        </t>
                        <t t-else="">
                            <t t-set="move_line_qtys" t-value="move_line_qtys + [1]"/>
                        </t>
                    </t>
                    <t t-set="index_to_qtys"
                       t-value="{i: qty for i, qty in zip(range(0, len(move_line_qtys)), move_line_qtys)}"/>
                    <t t-set="num_pages" t-value="sum(move_line_qtys)// (nRows * nCols) + 1"/>

                    <div t-foreach="range(num_pages)" t-as="page" class="o_label_sheet" t-att-style="'padding: 5mm;'">
                        <!--<div class="page" style="width: 100mm; height: 150mm; border: 1px solid black; padding: 5mm;">-->

                            <div style="width: 90mm; height: 110mm; border: 5px solid black; margin: auto; position: relative; padding: 0; border-radius: 12px; overflow: hidden;">

                                 <div style="width: 100%; height: 40mm; text-align: center; overflow: hidden; border-bottom: 1px solid black; border-radius: 12px 12px 0 0;background-color: black">
                                    <div   t-field="docs.sale_order_partner_id.name" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px 12px 0 0;"/>
                                     <img t-att-src="docs.product_id.qr_code_uploaded" style="max-width: 50%;position: absolute;bottom: 8px;left: 16px;" />
                                     
                                </div>

                                <div>
                                   
                                    <p>
                                        <strong><span t-field="docs.product_id"/></strong><br/>
                                        <strong>Couleurs: <span t-field="docs.color"/></strong><br/>
                                        <strong>Années: <span t-field="docs.years"/></strong><br/>
                                
                                    </p>
                                      <p>
                                       
                                    </p>
                                    
                                  
                                   <div>
                                            
                                        <img  t-att-src="image_data_uri(docs.product_image)" style="width:100%;"/>
                                       
                                         <t t-if="docs.product_id.tracking != 'none' and (docs.lot_name or move_line.lot_id)">
                                                            <div t-field="docs.lot_name or docs.lot_id.name" t-options="{'widget': 'barcode', 'img_style': 'width:100%;height:25%'}"/>
                                                            <div class="o_label_4x12 text-center"><span t-out="docs.lot_name or docs.lot_id.name">Demo Barcode</span></div>
                                                        </t>
                                                        <t t-elif="docs.product_id.tracking == 'none' and docs.product_id.barcode">
                                                            <div t-field="docs.product_id.barcode" t-options="{'widget': 'barcode', 'img_style': 'width:100%;height:25%'}"/>
                                                            <div class="o_label_4x12 text-center"><span t-out="docs.product_id.barcode">12345678901</span></div>
                                                        </t>
                                    </div>
                                </div>

                            <div class="col-5">
                                <span class="text-end">
                                    <span t-field="docs.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:350px;height:60px'}">Package barcode</span>
                                </span>
                            </div>


                                

                                <!--
                                <table class="my-0 table table-sm table-borderless" style="width: 100%; height: auto;">
                                    <t t-foreach="range(nRows)" t-as="row">
