<odoo>
    <!--test -->
    <data>
        <template id="label_production_view_pdf_custom" inherit_id="mrp.label_production_view_pdf">
            <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
                 <t t-call="web.basic_layout">
                    <!-- Outer Container -->
                    <div style="width: 100mm; height: 150mm; border: 1px solid black; border-radius: 12px; overflow: hidden; font-family: Arial, sans-serif;">
                        <!-- Header Section -->
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 28px; background-color: black; color: white; border-radius: 12px 12px 0 0;">
                            <!-- DesignerTrim Logo -->
                            <div style="font-size: 14px; font-weight: bold; text-align: left;">
                                <span t-field="docs.sale_order_partner_id.name" />
                            </div>
                            <!-- QR Code -->
                            <div>
                                <t t-if="docs.product_id.qr_code_uploaded">
                                    <img t-att-src="image_data_uri(docs.product_id.qr_code_uploaded)" 
                                         style="width: 25mm; height: 25mm; position: absolute; right: 100mm; background-color: white;  border-radius: 5px;" />
                                </t>

                                <t t-else="">
                                    <span style="font-size: 10px;">No QR Code</span>
                                </t>
                            </div>
                        </div>

                        <!-- Product Details Section -->
                        <div style="padding: 5mm;">
                            <p style="margin: 0; font-size: 12px;">
                                <strong>Model:</strong> <t t-esc="docs.product_id.display_name" />
                            </p>
                            <p style="margin: 0; font-size: 12px;">
                                <strong>Type:</strong> <t t-esc="docs.product_id.detailed_type" />
                            </p>
                            <p style="margin: 0; font-size: 12px;">
                                <strong>Year:</strong> <t t-esc="docs.years or ''" />
                            </p>
                            <p style="margin: 0; font-size: 12px;">
                                <strong>Color:</strong> <t t-esc="docs.interior_color or ''" />
                            </p>
                        </div>

                        <!-- Product Image Section -->
                        <div style="width: 100%; height: 50mm; text-align: center; border: 1px solid gray; margin-bottom: 5mm;">
                            <img t-att-src="image_data_uri(docs.selected_image)" 
                                 style="max-width: 100%; height: 100%; object-fit: contain;" />
                        </div>

                        <!-- Part and Barcode Section -->
                        <div style="text-align: center;">
                            <p style="margin: 0; font-size: 12px;">
                                <strong>PART#:</strong> <span t-field="docs.product_id.name" />
                                <span t-field="docs.interior_color" />
                                <span t-field="docs.insert_color" />
                            </p>
                            <div style="margin-top: 5mm;">
                                <t t-if="docs.product_id.tracking != 'none' and docs.lot_name">
                                    <div t-field="docs.lot_name" t-options="{'widget': 'barcode', 'img_style': 'width:80%; height:30px'}" />
                                </t>
                                <t t-elif="docs.product_id.barcode">
                                    <div t-field="docs.product_id.barcode" t-options="{'widget': 'barcode', 'img_style': 'width:80%; height:30px'}" />
                                </t>
                                <t t-else="">
                                    <span>No barcode available</span>
                                </t>
                            </div>
                        </div>

                        <!-- Footer Section -->
                        <div style="text-align: center; margin-top: 5mm; font-size: 12px; font-weight: bold;">
                            <t t-esc="docs.product_id.barcode or ''" />
                        </div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
