<odoo>
    <!--test -->
    <data>
        <template id="label_production_view_pdf_custom" inherit_id="mrp.label_production_view_pdf">
            <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
                 <t t-call="web.basic_layout">
                    <!-- Outer Container -->
                    <div style="width: 100mm; height: 200mm; border: 1px solid black; border-radius: 12px; overflow: hidden; font-family: Arial, sans-serif;">
                        <!-- Header Section -->
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 28px; background-color: black; color: white; border-radius: 12px 12px 0 0;">
                            <!-- DesignerTrim Logo -->
                            <div style="font-size: 14px; font-weight: bold; text-align: left;">
                                <span t-field="docs.sale_order_partner_id.name"/>
                            </div>
                            <!-- QR Code -->
                            <div style="display: flex; justify-content: flex-end; align-items: center; max-width: 100mm; overflow: hidden;">

                                <t t-if="docs.product_id.qr_code_uploaded">
                                    <img t-att-src="image_data_uri(docs.product_id.qr_code_uploaded)" style="width: 25mm; height: 25mm; position: absolute; right: 110mm; background-color: white;  border-radius: 5px;"/>
                                </t>

                                <t t-else="">
                                    <span style="font-size: 10px;">No QR Code</span>
                                </t>
                            </div>


                            
                            
                            
                        </div>


                               

                        <!-- Product Details Section <t t-esc="docs.product_id.detailed_type"/>  -->
                        <div style="padding: 5mm;">
                            <!-- Top Left: Year -->
                            <div style="text-align: left; font-size: 14px; margin-bottom: 5mm;width: 150px;">
                                <strong>
                                    <t t-esc="docs.product_brand or 'No Brand'"/>
                                    <t t-esc="docs.year or 'XXXX'"/>
                                </strong><br/>
                                <!--<div style="text-align: left;">-->
                                    <strong>
                                    <t t-esc="docs.product_style"/>
                                    <t t-esc="docs.product_model or 'Type'"/>
                                    </strong>
                                <!--</div>-->
                            </div>
                        

                            <!-- Content Area -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-end; font-size: 14px; width: 100%;">
                                <!-- Bottom Left: Marque -->
                                
                                <!-- Bottom Right: Color -->
                                <div style="text-align: right;">
                                     <t t-if="docs.interior_color and docs.interior_color not in ['None', 'No insert', 'Not Applicable','No Color','']">
                                            <strong>Interior Color:</strong>
                                            <t t-esc="docs.interior_color"/>
                                            <br/>
                                        </t>
                                        
                                        <t t-if="docs.insert_color and docs.insert_color not in ['None', 'No insert', 'Not Applicable','No Color','']">
                                            <strong>Insert Color:</strong>
                                            <t t-esc="docs.insert_color"/>
                                            <br/>
                                        </t>
                                        
                                        <t t-if="docs.paint_code and docs.paint_code not in ['None', 'No insert', 'Not Applicable','No Color','']">
                                            <strong>Paint Code:</strong>
                                            <t t-esc="docs.paint_code"/>
                                            <br/>
                                        </t>
                                     <t t-if="docs.main_color and docs.main_color not in ['None', 'No insert', 'Not Applicable','No Color','']">
                                            <strong>Main Code:</strong>
                                            <t t-esc="docs.main_color"/>
                                            <br/>
                                        </t>
                                     <t t-if="docs.carbon_code and docs.carbon_code not in ['None', 'No insert', 'Not Applicable','No Color','']">
                                            <strong>Carbon Code:</strong>
                                            <t t-esc="docs.carbon_code"/>
                                            <br/>
                                        </t>
                                    
                                </div>
                            </div>
                        </div>

                <!-- Product Image Section -->
                <div style="height: 70mm; border: 1px solid gray; margin: 2mm; display: table;">
                    <div style="display: table-cell; vertical-align: middle; text-align: center;">
                        <t t-if="docs.selected_image">
                            <img t-att-src="image_data_uri(docs.selected_image)" style="max-width: 90%; max-height: 90%; object-fit: contain;"/>
                        </t>
                        <t t-else="">
                            <span style="font-size: 10px; color: gray;">No Image</span>
                        </t>
                    </div>
                </div>


                <!-- Part and Barcode Section -->
                <div style="text-align: center; height: 13mm;">
                    <!--<p style="font-size: 14px; border: 1px solid black; margin: 2mm; text-align: center;">
                        <strong>Part: <span t-esc="docs.product_id.default_code + '-' + (docs.interior_color.split('(')[-1].strip(')') if docs.interior_color and '(' in docs.interior_color else docs.interior_color) + (('-' + docs.insert_color.split('(')[-1].strip(')')) if docs.insert_color and '(' in docs.insert_color else '') or ''"/></strong>
                    </p>-->
                    
                    <t t-set="default_code" t-value="docs.product_id.default_code or ''"/>
                    <t t-set="interior" t-value="(docs.interior_color.split('(')[-1].strip(')') if docs.interior_color and '(' in docs.interior_color else (docs.interior_color or ''))"/>
                    <t t-set="insert" t-value="(docs.insert_color.split('(')[-1].strip(')') if docs.insert_color and '(' in docs.insert_color else '')"/>
                    <t t-set="main" t-value="(docs.main_color.split('(')[-1].strip(')') if docs.main_color and '(' in docs.main_color else '')"/>
                    
                   
                    <p style="font-size: 14px; border: 1px solid black; margin: 2mm; text-align: center;">
                            <strong>Part: 
                                <span t-esc="(default_code + '-' if default_code else '') + interior + ('-' + insert if insert else '') + ('-' + main if main else '')"/>
                            </strong>
                    </p>
                    
                    

                    <div style="margin-top: 2mm;">
                        <t t-if="docs.product_id.tracking != 'none' and docs.lot_name">
                            <div t-field="docs.lot_name" t-options="{'widget': 'barcode', 'img_style': 'width:80%; height:30px'}"/>
                        </t>
                        <t t-elif="docs.product_id.barcode">
                            <div t-field="docs.product_id.barcode" t-options="{'widget': 'barcode', 'img_style': 'width:80%; height:30px'}"/>
                        </t>
                        <t t-else="">
                            <span/>
                        </t>
                    </div>

                    <div style="text-align: center; margin-top: 2mm; font-size: 14px; font-weight: bold;">
                        <t t-esc="docs.product_id.barcode or ''"/>
                    </div>
                </div>

            </div>
        </t>
    </xpath>
        </template>
    </data>
</odoo>
