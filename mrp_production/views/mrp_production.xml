   <record id="view_mrp_production_form_inherit" model="ir.ui.view">
    <field name="name">mrp.production.form.inherit</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
       
        <xpath expr="//div[@name='bom_div']" position="after">
            <field name="design_ids"/>
        </xpath>
      <xpath expr="//group[@name='group_extra_info']" position="inside">
        <field name="shopify_instance_id"/>
      </xpath>
       <xpath expr="//group[1]" position="after" >
         <group name="product_image_group" string="Détails du Produit" invisible="not product_id" >
            
            <field name="product_image" widget="image"/>
            <field name="selected_characteristics" />
           <!-- <field name="product_variant_ids"  widget="many2many_tags"/>
            <field name="product_tag_ids"  widget="many2many_tags"/>-->
         </group>
         <group name="product_icontrol_group" string="Contrôle produits" invisible="state !='done'" >
            <field name="product_finalized"/>
            <field name="is_conforme"/>
           <field name="remarque_controle_qualite"/>
         </group>
        </xpath>
       
    </field>
</record>

   <record id="view_mrp_production_tree_inherit" model="ir.ui.view">
    <field name="name">mrp.production.tree.inherit</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
    <field name="arch" type="xml">
     <xpath expr="//field[@name='state']" position="after">
        <field name="finalization_status" invisible="state !='done'"  widget="badge" decoration-success="finalization_status == 'finalise'"  decoration-danger="finalization_status== 'non_finalise'" />
         <field name="conform_status" invisible="state !='done'"  widget="badge" decoration-success="conform_status == 'conforme'"  decoration-danger="conform_status == 'non_conforme'" />
      </xpath>
      <xpath expr="//tree//field[@name='product_id']" position="after">
            <field name="color"/>
        </xpath>
       
    </field>
</record>

</odoo>
