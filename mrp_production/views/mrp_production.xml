<?xml version='1.0' encoding='UTF-8'?>
<odoo>

  <record id="view_picking_form_inherit_shopify_instance" model="ir.ui.view">
            <field name="name">stock.picking.form.shopify.instance</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Add the shopify_instance_id field under the origin field -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="shopify_instance_id" />
                </xpath>
            </field>
  </record>

  <record id="view_mrp_bom_form_inherit" model="ir.ui.view">
    <field name="name">mrp.bom.form.inherit</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
       
        <xpath expr="//page[3]" position="after">
            <page string="Dessins">
                <field name="design_ids">
                    <tree>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="pdf_file"/>
                        <field name="upload_date"/>
                        <field name="create_uid"/>
                    </tree>
                </field>
            </page>
        </xpath>

      
    </field>
</record>
