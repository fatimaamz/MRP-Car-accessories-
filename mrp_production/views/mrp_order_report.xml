<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <template id="report_picking_custom_external_layout" inherit_id="web.external_layout_bold">
        <xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']" position="replace">
           
            
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <div class="o_clean_header"> 
                    

                    <t t-if="o._name == 'stock.picking'">
                        <t t-if="o and o.sale_order_partner_id and o.sale_order_partner_id.name in ['DESIGNER TRIM', 'MYCAR TRIM', 'DYNA PERFORMANCE']">
                        <div class="row">
                            <div class="col-6">
                                
                               
                                    <t t-if="o.sale_order_partner_id and (o.sale_order_partner_id.name == 'DESIGNER TRIM' or o.sale_order_partner_id.name == 'MYCAR TRIM' or o.sale_order_partner_id.name == 'DYNA PERFORMANCE')">
    
                                        <div class="row">
                                        <div class="col-6">
                                         <t t-if="o.sale_order_partner_id.image_1920">
                                                <img t-att-src="image_data_uri(o.sale_order_partner_id.image_1920)" 
                                                     alt="Client Logo" 
                                                     style="max-height: 100px;" />
                                            </t>
                                        </div>
                                        </div>
                                        <ul class="list-unstyled">
                                            <li>
                                                <p t-esc="o.sale_order_partner_id.contact_address" />
                                            </li>
                                            <li>
                                                <t t-esc="o.sale_order_partner_id.email" />
                                            </li>
                                            <li>
                                                 <t t-esc="o.sale_order_partner_id.phone" />
                                            </li>
                                            <li>
                                                 <t t-esc="o.sale_order_partner_id.website" />
                                            </li>
                                        </ul>
                                    </t>
                                    
                                    <t t-else="">
                                        <div class="row">
                                        <div class="col-6">
                                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                                        </div>
                                       
                                    </div>
                                    <div class="col-5 offset-1" name="company_address"> 
                                            <ul class="list-unstyled" name="company_address_list">
                                                <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}">
                                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                                        <strong>Company address block</strong>
                                                        <div>Contains the company address.</div>
                                                    </div>
                                                </span></li>
                                                <li t-else="">
                                                    <span t-field="company.company_details">
                                                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                                            <strong>Company details block</strong>
                                                            <div>Contains the company details.</div>
                                                        </div>
                                                    </span>
                                                </li>
                                                <li t-if="not forced_vat"/>
                                                <li t-else="">
                                                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                                    <span t-esc="forced_vat">US12345671</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </t>
                                </t>
                          
                        </div>

                        
                    </div>
                    </t>


                <t t-else="">
                <div class="row">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    </div>
                   
                </div>
                <div class="col-5 offset-1" name="company_address"> 
                        <ul class="list-unstyled" name="company_address_list">
                            <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company address block</strong>
                                    <div>Contains the company address.</div>
                                </div>
                            </span></li>
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                </t>
                </div>
            
            </div>
        </xpath>




        <!-- Footer -->
        
           <xpath expr="//div[@t-attf-class='footer o_clean_footer o_company_#{company.id}_layout']" position="replace">
           
            <div t-attf-class="footer o_clean_footer o_company_#{company.id}_layout">
                  <t t-if="o._name == 'stock.picking'">
                <t t-if="o.sale_order_partner_id.name and (o.sale_order_partner_id.name == 'DESIGNER TRIM' or o.sale_order_partner_id.name == 'MYCAR TRIM' or o.sale_order_partner_id.name == 'DYNA PERFORMANCE')">

                    <div class="row">
                        
                        <div class="col-4">
                           <ul class="list-unstyled">
                                                <li>
                                                    <p t-esc="o.sale_order_partner_id.contact_address" />
                                                </li>
                                                <li>
                                                    <t t-esc="o.sale_order_partner_id.email" />
                                                </li>
                                               
                                            </ul>
                        </div>
                        <div class="col-3">
                              <ul class="list-unstyled">
                                 <li>
                                        <t t-esc="o.sale_order_partner_id.phone" />
                                </li>
                                <li>
                                        <t t-esc="o.sale_order_partner_id.website" />
                                </li>
                              </ul>
                        </div>
                        <div class="col-1">
                            <ul t-if="report_type == 'pdf'" class="list-inline pagenumber float-end text-center">
                                <li class="list-inline-item"><strong><span class="page"/></strong></li>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
            <t t-else="">

                <div class="row">
                <div class="col-4">
                    <span t-field="company.report_footer"/>
                </div>
                <div class="col-4">
                    <span t-if="company.is_company_details_empty" t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
                    <span t-else="" t-field="company.company_details"/>
                </div>
                <div class="col-3">
                    <div class="mt0 mb0 h5" t-if="company.report_header" t-field="company.report_header">Company tagline</div>
                </div>
                <div class="col-1">
                    <ul t-if="report_type == 'pdf'" class="list-inline pagenumber float-end text-center">
                        <li class="list-inline-item"><strong><span class="page"/></strong></li>
                    </ul>
                </div>
            </div> </t>
          
            </div>
            
          </xpath>

       
    </template>



     

     <template id="report_picking_inherit_shopify_instance" inherit_id="stock.report_picking">
        <xpath expr="//div[@class='row mt32 mb32']" position="inside">
            
            <div t-if="o.shopify_instance_id" class="col-auto" name="div_shopify_instance">
                <strong>Origine :</strong>
                <p t-field="o.shopify_instance_id.name"/>
            </div>
        </xpath>

        <xpath expr="//span[@t-if='ml.product_id.description_picking']" position="replace">
            <!-- Replace the original span to filter out unwanted values -->
            <span t-if="ml.product_id.description_picking">
                <t t-foreach="ml.product_id.description_picking.split('\n')" t-as="line">
                    <t t-if="not ('None' in line or 'No Color' in line or 'No insert' in line)">
                        <p t-esc="line.strip()"/>
                    </t>
                </t>
            </span>
        </xpath>
    </template>


    
    <template id="report_mrporder_inherit" inherit_id="mrp.report_mrporder">
        
        
        <xpath expr="//div[@class='page']" position="replace">
            <div class="page">
                    <div class="oe_structure"/>
                    <div class="row">
                        <div class="col-7">
                            <h2><span t-field="o.name">MRP-001</span></h2>
                        </div>
                        <div class="col-5">
                            <span class="text-end">
                                <span t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:350px;height:60px'}">Package barcode</span>
                            </span>
                        </div>
                    </div>
                    <div class="row mt32 mb32">
                        <div class="col-3" t-if="o.origin">
                            <strong>Source:</strong><br/>
                            <span t-field="o.origin">Vendor ABC</span>
                        </div>
                        <div class="col-3" t-if="o.user_id">
                            <strong>Responsible:</strong><br/>
                            <span t-field="o.user_id">John Doe</span>
                        </div>
                        <div class="col-3" t-if="o.state not in ('done', 'cancel') and o.date_deadline">
                            <strong>Deadline:</strong><br/>
                            <span t-field="o.date_deadline">2023-09-15</span>
                        </div>
                        
                        <div class="col-3" t-if="o.partner_id">
                            <strong>Client:</strong><br/>
                            <span t-esc="o.partner_id.name"/>
                        </div>
                         <div class="col-3" t-if="o.partner_shipping_id">
                            <strong>Adresse de livraison :</strong><br/>
                            <span t-esc="o.partner_shipping_id.contact_address"/>
                        </div>
                        
                    </div>

                    <div class="row mt32 mb32">
                        <!--<div class="col-3">
                            <strong>Product:</strong><br/>
                            <span t-field="o.product_id">Laptop Model X</span>
                        </div>-->
                       <!-- <div class="col-3" t-if="o.product_description_variants">
                            <strong>Description:</strong><br/>
                            <span t-field="o.product_description_variants">Laptop with 16GB RAM</span>
                        </div>-->
                        <div class="col-3" t-if="o.selected_characteristics">
                            <strong>Produit:</strong><br/>
                            <span t-field="o.selected_characteristics">Laptop with 16GB RAM</span>
                        </div>
                        <div class="col-3" t-if="o.selected_characteristics">
                            <strong>Réf Produit:</strong><br/>
                            <span t-field="o.product_id.name">Laptop with 16GB RAM</span>
                        </div>
                      
                        <div class="col-3">
                            <strong>Quantity to Produce:</strong><br/>
                            <span t-field="o.product_qty">100</span>
                            <span t-field="o.product_uom_id.name" groups="uom.group_uom">Units</span>
                        </div>
                        <div class="col-3" t-if="o.qty_producing">
                            <strong>Quantity Producing:</strong><br/>
                            <span t-field="o.qty_producing">50</span>
                            <span t-field="o.product_uom_id.name" groups="uom.group_uom">Units</span>
                        </div>
                         <div class="col-3" t-if="o.shopify_instance_id">
                            <strong>Origine:</strong><br/>
                            <span t-field="o.shopify_instance_id">Site</span>
                        </div>
                       
                    </div>
                    
                    <!-- <div class="col-5 text-center">
                        <t t-if="o.product_image">
                            <img t-if="o.product_image" t-att-src="image_data_uri(o.product_image)" style="width: 90%"/>
                        </t>
                    </div>-->
                    
                     <div  t-if="o.selected_image">
                            <strong>Image Produit:</strong><br/>
                            <img t-if="o.selected_image" t-att-src="image_data_uri(o.selected_image)" style="width: 90%"/>                       
                    </div><br/>
<div>
                <t t-if="o.message_ids.filtered(lambda m: m.message_type == 'comment' and not m.subtype_id)">
                    <h5>Notes Internes :</h5>
                    <t t-foreach="o.message_ids.filtered(lambda m: m.message_type == 'comment' and not m.subtype_id)" t-as="message">
                        <div>
                            <strong><t t-esc="message.create_uid.name"/>:</strong>
                            <span t-raw="message.body" />
                            <br/>
                            <small><t t-esc="message.date" /></small>
                        </div>
                    </t>
                </t>

                <t t-if="o.message_ids.filtered(lambda m: m.message_type != 'notification')">
            <h5>Messages :</h5>
            <t t-foreach="o.message_ids.filtered(lambda m: m.message_type != 'notification')" t-as="message">
                <div>
                    <strong><t t-esc="message.create_uid.name"/>:</strong>
                    <span t-raw="message.body" />
                    <br/>
                    <small><t t-esc="message.date" /></small>
                </div>
            </t>
        </t>
</div>

                <div t-if="o.workorder_ids" groups="mrp.group_mrp_routings">
                        <h3>
                            <span t-if="o.state == 'done'">Operations Done</span>
                            <span t-elif="o.is_planned">Operations Planned</span>
                            <span t-else="">Operations</span>
                        </h3>
                        <table class="table table-sm">
                            <tr>
                                <th><strong>Operation</strong></th>
                                <th><strong>WorkCenter</strong></th>
                                <th><strong>Duration (minutes)</strong></th>
                                <th t-if="o.state in ('progress', 'to_close')"><strong>Actual Duration (minutes)</strong></th>
                                <th style="width:30%"><strong>Barcode</strong></th>
                            </tr>
                            <tr t-foreach="o.workorder_ids" t-as="line2">
                                <td><span t-field="line2.name">Assembling</span></td>
                                <td><span t-field="line2.workcenter_id.name">Center A</span></td>
                                <td>
                                    <span t-if="o.state != 'done'" t-field="line2.duration_expected">60</span>
                                    <span t-if="o.state == 'done'" t-field="line2.duration">58</span>
                                </td>
                                <td t-if="o.state in ('progress', 'to_close')">
                                    <span t-field="line2.duration">58</span>
                                </td>
                                <td>
                                    <span t-field="line2.barcode" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:35px'}">987654321098</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div t-if="o.move_raw_ids">
                        <t t-call="mrp.report_mrp_production_components"/>

                    </div>
                    <div class="oe_structure"/>
                </div>
        </xpath>



       
        
    </template>
</odoo>
