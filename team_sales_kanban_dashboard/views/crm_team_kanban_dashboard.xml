<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <!-- Action personnalisée -->
<record id="action_crm_team_weekly_stats" model="ir.actions.act_window">
    <field name="name">Statistiques commerciales (7 jours)</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">graph,pivot</field>
    <field name="context">{'search_default_last_7_days': 1}</field>
    <field name="domain">[('date_order', '>=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]</field>
</record>

<!-- Menu dans CRM -->
<menuitem id="menu_crm_team_weekly_stats"
          name="Stats commerciales (7j)"
          parent="crm.crm_menu_root"
          action="action_crm_team_weekly_stats"
          sequence="90" />

</odoo>






