<odoo>
    <record id="view_crm_team_kanban_dashboard" model="ir.ui.view">
        <field name="name">crm.team.kanban.dashboard</field>
        <field name="model">crm.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="o_kanban_primary_left">
                                <strong><field name="name"/></strong>
                                <div>
                                    <span><field name="quote_count"/> Devis</span><br/>
                                    <span><field name="order_count"/> Commandes confirmées</span><br/>
                                    <span>Total: <field name="total_sales" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                </div>
                                <div t-if="record.weekly_sales.raw_value">
                                    <t t-set="bars" t-value="record.weekly_sales.raw_value.split(',')"/>
                                    <div class="o_bar_chart" style="margin-top:10px;">
                                        <t t-foreach="bars" t-as="val">
                                            <div style="display:inline-block; width:10px; height:50px; background:#ddd; margin:2px; vertical-align:bottom;">
                                                <div t-att-style="'height:%spx; background-color:#5A5AFA'" t-attf-style="height:#{int(val)//100}px;"></div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
