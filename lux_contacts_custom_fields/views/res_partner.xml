<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//group[1]" position="inside">
                 <field name="supplier_rank" invisible="1"/>
                 <field name="customer_rank" invisible="1"/>
                <group>
                        
                        <field name="type_client" invisible="supplier_rank &gt;= 1"/>
                        <field name="type_fournisseur" invisible="customer_rank &gt;= 1"/>
                        <field name="region" invisible="1"/>
                        <field name="type_paiement"/>
                        <field name="oem"/>
                        <field name="dealer_Code"/>
			<field name="type_groupe_1"/>
			<field name="type_groupe_2"/>
                        <field name="installation"/>
                        <field name="prov"/>
                </group>
                
                    
            </xpath>
        </field>
    </record>

    <record id="inherit_res_partner_search" model="ir.ui.view">
		<field name="name">res.partner.searchview</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_res_partner_filter"/>
		<field name="arch" type="xml">

			<filter name="type_person" position="before">
				<field name="type_fournisseur" string="Type Fournisseur" filter_domain="[('type_fournisseur', 'ilike', self)]"/>
                <field name="type_client" string="Type Client" filter_domain="[('type_client', 'ilike', self)]"/>
			
			</filter>

		</field>
	</record>

</odoo>
