<odoo>

    <record id="view_order_line_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.line.form.inherit</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//tree[1]//field[@name='tax_id']" position="after">
                    <field name="installation"/>
                </xpath>
            </field>
     </record>
  <!--<record id="view_move_line_form_inherit" model="ir.ui.view">
            <field name="name">account.move.line.form.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_id']//tree" position="inside">
                    <field name="installation"/>
                </xpath>
            </field>
        </record>-->
	
	

   <record id="view_stock_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">

            <xpath expr="//tree" position="inside">
                 <field name="po" />
                    
            </xpath>
        </field>
    </record>
	

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
	     <xpath expr="//group[1]//group[1]//field[@name='country_id']" position="attributes">
		     <attribute name="invisible">1</attribute>
	     </xpath>
            <xpath expr="//group[1]" position="inside">
                 <field name="supplier_rank" invisible="1"/>
                 <field name="customer_rank" invisible="1"/>
                <group>
                        
                        <field name="type_client" invisible="supplier_rank &gt;= 1"/>
                        <field name="type_fournisseur" invisible="customer_rank &gt;= 1"/>
                        <field name="region" invisible="1"/>
                        <!--<field name="type_paiement"/>-->
                        <field name="oem"/>
                       <!-- <field name="dealer_Code"/>-->
			<!--<field name="type_groupe_1"/>
			
                        <field name="installation"/>
                        <field name="prov"/>-->
                </group>
                
                    
            </xpath>
        </field>
    </record>

    <record id="inherit_res_partner_search" model="ir.ui.view">
		<field name="name">res.partner.searchview</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_res_partner_filter"/>
		<field name="arch" type="xml">

			<filter name="type_person" position="before">
				<field name="type_fournisseur" string="Type Fournisseur" filter_domain="[('type_fournisseur', 'ilike', self)]"/>
                <field name="type_client" string="Type Client" filter_domain="[('type_client', 'ilike', self)]"/>
			
			</filter>

		</field>
	</record>


 <record id="lux_view_mrp_production_form_inherit" model="ir.ui.view">
	    <field name="name">mrp.production.form.inherit</field>
	    <field name="model">mrp.production</field>
	    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
	    <field name="arch" type="xml">
		<xpath expr="//group[@name='group_extra_info']" position="inside">
	             <field name="installation"/>
	      </xpath>
	    </field>
</record>

</odoo>
