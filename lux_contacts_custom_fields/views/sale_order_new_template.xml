<?xml version="1.0" encoding="UTF-8"?>

<odoo>
  
        <record id="action_report_saleorder_new_template" model="ir.actions.report">
            <field name="name">Sales Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">lux_contacts_custom_fields.report_saleorder_new_template</field>
            <field name="report_file">lux_contacts_custom_fields.report_saleorder_new_template</field>
            <field name="print_report_name">"Sales Order - %s" % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
        </record>


        <template id="report_saleorder_new_template">


             <t t-call="web.basic_layout">
             
                <t t-foreach="docs" t-as="doc">
                    <main>
                        <!-- Header Section -->
                        <div class="header"
                             style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border: none !important;">
                            <table style="width: 100%; border: none; padding: 10px 0;">
                                <tr>
                                    <td style="text-align: left; vertical-align: middle; padding-right: 20px;">
                                        <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)"
                                             style="height: 60px;" alt="Company Logo"/>
                                        <h2 style="display: inline-block; margin-left: 10px; vertical-align: middle; margin-bottom: 0;">
                                            Sales Order
                                        </h2>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <div style="text-align: justify; width: 100%;">
                                            <strong style="font-size: 16px;">
                                                <t t-esc="user.company_id.name"/>
                                            </strong>
                                            <br/>
                                            <span style="font-size: 14px;">
                                                <t t-esc="user.company_id.email or ''"/>
                                                /
                                                <t t-esc="user.company_id.phone or ''"/>
                                            </span>
                                            <br/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 30px;">
                            <table style="width: 100%; border-spacing: 5; margin-bottom: 10px;">
                                <tr>
                                    <!-- Left Block: Customer Information -->
                                    <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px; border: none !important;">
                                        <strong style="font-size: 16px;">
                                            <t t-esc="doc.partner_id.name"/>
                                        </strong>
                                        <br/>
                                        <t t-esc="doc.partner_id.phone or ''"/>
                                        <br/>
                                        <t t-esc="doc.partner_id.street or ''"/>,
                                        <t t-esc="doc.partner_id.city or ''"/>,
                                        <t t-esc="doc.partner_id.state_id.name or ''"/>
                                        <br/>
                                        <br/>
                                        <t t-esc="doc.partner_id.zip or ''"/>
                                        <t t-esc="doc.partner_id.country_id.name or ''"/>
                                    </td>

                                    <!-- Center Block: Ship To -->
                                    <td style="padding: 10px; background-color: #f9fbff; border-radius: 10px; border: 1px solid #ddd; vertical-align: top; width: 40%; font-size: 14px;">
                                        <span>
                                            <strong>
                                                <span t-esc="'Ship to / Expédié à :'"/>
                                            </strong>
                                        </span>
                                        <br/>
                                        <br/>
                                        <t t-esc="doc.partner_shipping_id.name or ''" style="font-weight: bold;"/>
                                        <br/>
                                        <br/>
                                        <t t-esc="doc.partner_shipping_id.street or ''"/>
                                        <br/>
                                        <t t-esc="doc.partner_shipping_id.city or ''"/>,
                                        <t t-esc="doc.partner_shipping_id.state_id.name or ''"/>,
                                        <t t-esc="doc.partner_shipping_id.zip or ''"/>
                                        <br/>
                                        <br/>
                                        <!--<t t-esc="doc.partner_shipping_id.country_id.name or ''"/>-->
                                        <br/>
                                        <br/>
                                        <span>Téléphone :
                                            <t t-esc="doc.partner_shipping_id.phone or ''"/>
                                        </span>
                                        <br/>
                                        <br/>
                                        <span>Ship Date :
                                            <t t-esc="doc.date_order.strftime('%B %d, %Y')"/>
                                        </span>
                                    </td>

                                    <!-- Right Block: Order Details -->
                                    <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px; border: none !important;">
                                        <strong style="font-size: 16px;">Order Details:</strong>
                                        <br/>
                                        <br/>
                                        Date:
                                        <t t-esc="doc.date_order and doc.date_order.strftime('%B %d, %Y') or ''"/>
                                        <br/>
                                        <br/>
                                        Order N°:
                                        <t t-esc="doc.name"/>
                                        <br/>
                                        <br/>
                                        PO Client:
                                        <t t-esc="doc.partner_shipping_id.po or ''"/>
                                        <br/>
                                        <br/>
                                        <t t-if="doc.invoice_ids">
                                            Facture N°:
                                            <t t-esc="doc.invoice_ids[0].name or ''"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <t t-set="delivery_details" t-value="doc.get_delivery_details()"/>
                        <t t-if="delivery_details">
                            <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">


                                <thead>
                                    <tr style="background-color: #f9fbff;">
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">N°</th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Tracking
                                            Number
                                        </th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Must Ship
                                            By
                                        </th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Ship Via
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <t t-foreach="delivery_details" t-as="delivery">
                                        <tr>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['N° semaine']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Tracking number']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Must ship by']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Ship via']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>


                        <!-- Product Details Table (Table 2) -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <thead>
                                <tr style="background-color: #f9fbff;">
                                    <th style="border: 1px solid #ddd; padding: 10px;">N°</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Image</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Description</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Couleur</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">EnStock</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td style="border: 1px solid #ddd; padding: 10px;">
                                            <t t-esc="counter"/>
                                        </td>
                                        <!-- Image Column -->
                                        <td class="text-right">
                                            <img t-if="line.image_128" t-att-src="image_data_uri(line.image_128)"
                                                 style="width: 200px; height: 200px;"/>
                                        </td>


                                        <!-- Description Column -->
                                        <td style="border: 1px solid #ddd; padding: 10px;">
                                            <t t-esc="line.name or ''"/>
                                        </td>
                                        <!-- Couleur -->
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.insert_color  or ' '"/>
                                        </td>
                                        <!-- EnStock -->
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.product_id.qty_available or 0"/>
                                        </td>
                                        <!-- Qty -->
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.product_uom_qty"/>
                                        </td>
                                    </tr>

                                </t>


                            </tbody>
                            <tr style="background-color: #f9fbff;">
                                <td colspan="5"
                                    style="text-align: right; font-weight: bold; padding: 10px; border-top: 2px solid #000;">
                                    Total de la commande :
                                </td>
                                <td style="text-align: center; font-weight: bold; padding: 10px; border-top: 2px solid #000;">
                                    <t t-esc="sum(line.product_uom_qty for line in doc.order_line)"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="doc.note">
                            <div style="margin-top: 20px; padding: 10px; font-size: 14px;">
                                <strong>Special note :</strong>
                                <br/>
                                <t t-esc="doc.note or ''"/>
                            </div>
                        </t>

                    </main>
                </t>
            </t>
        </template>
    

</odoo>
