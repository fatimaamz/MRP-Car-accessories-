<?xml version="1.0" encoding="UTF-8"?>

<odoo>
  
        <record id="action_report_saleorder_new_template" model="ir.actions.report">
            <field name="name">Sales Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">lux_contacts_custom_fields.report_saleorder_new_template</field>
            <field name="report_file">lux_contacts_custom_fields.report_saleorder_new_template</field>
            <field name="print_report_name">"Sales Order - %s" % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
        </record>


        <template id="report_saleorder_new_template">


             <t t-call="web.basic_layout">
                
             <div class="page" style="color: #2f374f;font-family: Inter;line-height: 1.3;">
                <t t-foreach="docs" t-as="doc">
                    <main>
                        <!-- Header Section -->
                      <div  class="header" style="width: 100%; display: flex; justify-content: space-between; align-items: center;">
                        <table style="width: 100%; border: none; padding: 10px 0; border-collapse: collapse;">
                            <tr style="border: 1px solid white;">
                                <td style="text-align: left; vertical-align: middle; padding-right: 20px; border: 1px solid white;">
                                    <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)"
                                         style="  width: 240px;height: 35px;" alt="Company Logo"/>
                                    <h2 style="display: inline-block; margin-left: 6px; vertical-align: middle; margin-bottom: 0;">
                                        Sales Order
                                    </h2>
                                </td>
                                 <td style="text-align: right; vertical-align: middle; border: 1px solid white;float: right;">
                                    <div style="text-align: justify; width: 100%; border: 1px solid white;">
                                        <strong style="font-size: 16px;">
                                            <t t-esc="user.company_id.name"/>
                                        </strong>
                                        <br/>
                                        <span>
                                               <t t-if="user.company_id.street">
                                            <t t-esc="user.company_id.street"/>
                                            <t t-if="user.company_id.city or user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.city">
                                            <t t-esc="user.company_id.city"/>
                                            <t t-if="user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.state_id">
                                            <t t-esc="user.company_id.state_id.name"/>
                                            <t t-if="user.company_id.country_id">, </t>
                                        </t>
                                        <br/>
                                        <t t-if="user.company_id.zip">
                                            <t t-esc="user.company_id.zip"/>
                                        </t>
                                        <t t-if="user.company_id.country_id">
                                            <t t-esc="user.company_id.country_id.name"/>
                                        </t>
                                        </span><br/>
                                        <span style="font-size: 14px;">
                                            
                                            <t t-esc="user.company_id.email or ''"/>
                                            /
                                            <t t-esc="user.company_id.phone or ''"/>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                        <div style="margin-top: 30px;">
                            <table style="width: 100%; border-spacing: 5; margin-bottom: 10px;">
                                <tr>
                                    <!-- Left Block: Customer Information -->
                                    <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px;  border: 1px solid white;">
                                        <strong style="font-size: 16px;">
                                            <t t-esc="doc.partner_id.name"/>
                                        </strong>
                                        <br/>
                                        <t t-esc="doc.partner_id.phone or ''"/>
                                        <br/>
                                        <t t-if="doc.partner_id.street">
                                        <t t-esc="doc.partner_id.street"/>
                                        <t t-if="doc.partner_id.city or doc.partner_id.state_id or doc.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="doc.partner_id.city">
                                        <t t-esc="doc.partner_id.city"/>
                                        <t t-if="doc.partner_id.state_id or doc.partner_id.country_id">, </t>
                                    </t>
                                    <t t-if="doc.partner_id.state_id">
                                        <t t-esc="doc.partner_id.state_id.name"/>
                                        <t t-if="doc.partner_id.country_id">, </t>
                                    </t>
                                    <br/>
                                    <t t-if="doc.partner_id.zip">
                                        <t t-esc="doc.partner_id.zip"/>
                                    </t>
                                    <t t-if="doc.partner_id.country_id">
                                        <t t-esc="doc.partner_id.country_id.name"/>
                                    </t>
                                    </td>

                                    <!-- Center Block: Ship To -->
                                    <td style="padding: 10px; border-radius: 15px;
                                              background-color: #f6f8fc;
                                              border: 1px solid white;
                                              height: 200px;
                                              display: flex;
                                              flex-direction: column;
                                            
                                              box-sizing: border-box;
                                             
                                              font-size: 16px;">
                                        <span>
                                            <strong>
                                                <span t-esc="'Ship to / Expédié à :'"/>
                                            </strong>
                                        </span>
                                        <br/>
                                        <br/>
                                        <t t-if="doc.partner_shipping_id.name">
                                           <strong> <t t-esc="doc.partner_shipping_id.name"/></strong>
                                            <br/>
                                            <br/>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.street">
                                            <t t-esc="doc.partner_shipping_id.street"/>
                                            <t t-if="doc.partner_shipping_id.city or doc.partner_shipping_id.state_id or doc.partner_shipping_id.zip">, </t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.city">
                                            <t t-esc="doc.partner_shipping_id.city"/>
                                            <t t-if="doc.partner_shipping_id.state_id or doc.partner_shipping_id.zip">, </t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.state_id">
                                            <t t-esc="doc.partner_shipping_id.state_id.name"/>
                                            <t t-if="doc.partner_shipping_id.zip">, </t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.zip">
                                            <t t-esc="doc.partner_shipping_id.zip"/>
                                        </t>
                                        <br/>
                                        <br/>
                                      <t t-if="doc.partner_shipping_id.email">
                                            <span> <t t-esc="doc.partner_shipping_id.email"/></span>
                                        </t><br/>
                                        <t t-if="doc.partner_shipping_id.phone">
                                            <span>Téléphone : <t t-esc="doc.partner_shipping_id.phone"/></span>
                                        </t>
                                        <br/>
                                        <br/>
                                        <span>Ship Date :
                                            <t t-esc="doc.date_order.strftime('%B %d, %Y')"/>
                                        </span>
                                    </td>

                                   
                                   <!-- <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px;   border: 1px solid white;">
                                        <strong style="font-size: 16px;">Order Details:</strong>
                                        <br/>
                                        <br/>
                                        Date:
                                        <t t-esc="doc.date_order and doc.date_order.strftime('%B %d, %Y') or ''"/>
                                        <br/>
                                        <br/>
                                        Order N°:
                                        <t t-esc="doc.name"/>
                                        <br/>
                                        <br/>
                                        PO Client:
                                        <t t-esc="doc.partner_id.po or ''"/>
                                        <br/>
                                        <br/>
                                        
                                        <t t-if="doc.invoice_ids">Facture N°:
                                            <t t-esc="doc.invoice_ids[0].name"/>
                                        </t>
                                    </td>-->


                                   <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 16px; border: 1px solid white;">
                                        <strong style="font-size: 14px;">Order Details:</strong>
                                        <br/><br/>
                                        <table style="width: 100%; border-spacing: 8px; font-size: 16px; border: 1px solid white;">
                                            <tr>
                                                <td style="width: 40%; text-align: left; padding-left: 5px; border: 1px solid white;">Date  </td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;">:</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;"> <t t-esc="doc.date_order and doc.date_order.strftime('%B %d, %Y') or ''"/></td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;">Order N°</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;">:</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;"> <t t-esc="doc.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;">PO Client</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;">:</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;"> <t t-esc="doc.partner_id.po or ''"/></td>
                                            </tr>
                                            <tr>
                                                <td  t-if="doc.invoice_ids" style="text-align: left; padding-left: 5px; border: 1px solid white;">Facture N°</td>
                                                <td  t-if="doc.invoice_ids" style="text-align: left; padding-left: 5px; border: 1px solid white;">:</td>
                                                <td style="text-align: left; padding-left: 5px; border: 1px solid white;"><t t-esc="doc.invoice_ids[0].name"/></td>
                                            </tr>
                                           
                                        </table>
                                    </td>
                                  
                                </tr>
                            </table>
                        </div>
                        <t t-set="delivery_details" t-value="doc.get_delivery_details()"/>
                        <t t-if="delivery_details">
                            <table style="width: 100%; border-collapse: collapse; margin-top: 20px;font-size: 16px;">


                                <thead>
                                    <tr style="background-color: #edeff2;">
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">N°</th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Tracking
                                            Number
                                        </th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Must Ship
                                            By
                                        </th>
                                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Ship Via
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <t t-foreach="delivery_details" t-as="delivery">
                                        <tr>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['N° semaine']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Tracking number']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Must ship by']"/>
                                            <td style="border: 1px solid #ddd; padding: 8px;"
                                                t-esc="delivery['Ship via']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>


                        <!-- Product Details Table (Table 2) -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <thead>
                                <tr style="background-color: #edeff2;">
                                   <!-- <th style="border: 1px solid #ddd; padding: 10px;">N°</th>-->
                                    <th style="border: 1px solid #ddd; padding: 10px;">Image</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Description</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Insert</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Color</th> 
                                    <th style="border: 1px solid #ddd; padding: 10px;">Qty</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Stock</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">To Prod.</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                                <!--<t t-set="counter" t-value="0"/>-->
                                <t t-foreach="doc.order_line" t-as="line">
                                   <!-- <t t-set="counter" t-value="counter + 1"/>-->
                                    <tr>
                                      <!--  <td style="border: 1px solid #ddd; padding: 10px;">
                                            <t t-esc="counter"/>
                                        </td>-->
                                        <!-- Image Column -->
                                        <!--<td class="text-right">
                                            <img t-if="line.image_128" t-att-src="image_data_uri(line.image_128)"
                                                 style="width: 200px; height: 200px;"/>
                                        </td>-->
                                     <td class="text-right">
                                          <t t-if="line.image_128">
                                              <div style=" text-align: center; padding: 10px;">
                                                  <img t-att-src="image_data_uri(line.image_128)"
                                                       style="width: 100px; height: 100px; object-fit: contain; display: block; border: none;"/>
                                              </div>
                                          </t>
                                      </td>


                                        <!-- Description Column -->
                                        <td style="border: 1px solid #ddd; padding: 10px;">
                                            <strong>
                                                    <t t-esc="line.name.split(' ', 1)[0]"/> <!-- Extracts the first word or token -->
                                                </strong>
                                                <span>
                                                    <t t-esc="' '.join(line.name.split(' ')[1:])"/> <!-- Extracts the rest of the text -->
                                                </span>
                                        </td>
                                        <!-- Couleur -->
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.insert_color  or ' '"/>
                                        </td>
                                      <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.interior_color  or ' '"/>
                                        </td>
                                      
                                      <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.product_uom_qty"/>
                                        </td>
                                        <!-- EnStock -->
                                        <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                            <t t-esc="line.product_id.qty_available or 0"/>
                                        </td>
                                      <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                                <t t-esc="line.product_uom_qty - (line.product_id.qty_available or 0)"/>
                                            </td>
                                        <!-- Qty -->
                                        
                                    </tr>

                                </t>


                            </tbody>
                           <!-- <tr style="background-color: #edeff2;">
                                <td colspan="5"
                                    style="text-align: right; font-weight: bold; padding: 10px; border-top: 2px solid #000;">
                                    Total de la commande :
                                </td>
                                <td style="text-align: center; font-weight: bold; padding: 10px; border-top: 2px solid #000;">
                                    <t t-esc="sum(line.product_uom_qty for line in doc.order_line)"/>
                                </td>
                            </tr>-->
                          <tr style="background-color: #edeff2; border: 1px solid white;">
                              <td colspan="6"
                                  style="text-align: right; font-weight: bold; padding: 10px; border: none !important;">
                                  Total de la commande :
                              </td>
                              <td style="text-align: center; font-weight: bold; padding: 10px; border: none !important;">
                                  <t t-esc="sum(line.product_uom_qty for line in doc.order_line)"/>
                              </td>
                          </tr>
                        </table>
                        <t t-if="doc.note">
                            <div style="margin-top: 20px; padding: 10px; font-size: 14px;">
                                <strong>Special note :</strong>
                                <br/>
                                <t t-esc="doc.note or ''"/>
                            </div>
                        </t>

                   </main>
                </t>
             </div>
            </t>
        </template>
    

</odoo>
