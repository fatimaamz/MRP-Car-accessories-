<odoo>
<record id="view_invoice_tree_inherit_export_etat_compte" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit.export</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[1]" position="before">
               <button name="action_generate_invoice_pdf"
                    type="object"
                    string="Etat des comptes"
                    class="btn-primary"
                    icon="fa-download"/>
            </xpath>
        </field>
    </record>
    
<template id="filtered_invoices_report_template">
         <t t-call="web.basic_layout">

             

           <div class="page" style="color: #2f374f;font-family: Inter;line-height: 1.3;">
                <t t-foreach="docs" t-as="doc">
                    <main>
                        <div class="header"
                             style="width: 100%; display: flex; justify-content: space-between; align-items: center;">
                            <table style="width: 100%; border: none; padding: 10px 0; border-collapse: collapse;">
                                <tr style="border: 1px solid white;">
                                    <td style="text-align: left; vertical-align: middle; padding-right: 20px; border: 1px solid white;">
                                        <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)"
                                                 style="  width: 240px;height: 35px;" alt="Company Logo"/><br/><br/>
                                        <h2 style="display: inline-block; margin-left: 6px; vertical-align: middle; margin-bottom: 0;">
                                            <strong>Invoice</strong>
                                        </h2>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle; border: 1px solid white;float: right;">
                                        <div style="text-align: justify; width: 100%; border: 1px solid white;">
                                            <strong style="font-size: 16px;">
                                                <t t-esc="user.company_id.name"/>
                                            </strong>
                                            <br/>
                                        <span>
                                               <t t-if="user.company_id.street">
                                            <t t-esc="user.company_id.street"/>
                                            <t t-if="user.company_id.city or user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.city">
                                            <t t-esc="user.company_id.city"/>
                                            <t t-if="user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.state_id">
                                            <t t-esc="user.company_id.state_id.name"/>
                                            <t t-if="user.company_id.country_id">, </t>
                                        </t>
                                        <br/>
                                        <t t-if="user.company_id.zip">
                                            <t t-esc="user.company_id.zip"/>
                                        </t>
                                        <t t-if="user.company_id.country_id">
                                            <t t-esc="user.company_id.country_id.name"/>
                                        </t>
                                        </span><br/>
                                            
                                            <span style="font-size: 14px;">
                                                <t t-esc="user.company_id.email or ''"/>
                                                /
                                                <t t-esc="user.company_id.phone or ''"/>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                <p>Date du jour :
                    <t t-esc="doc.date_today"/>
                </p>
                <!-- <p>Période : du <t t-esc="doc.filter_date_from"/> au <t t-esc="doc.filter_date_to"/></p>-->


                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;font-size: 16px;">
                    <thead>
                        <tr style=" background-color: #f7f7f7;">

                            <th style="border: 1px solid #ddd; padding: 10px;">Client</th>
                            <th style="border: 1px solid #ddd; padding: 10px;">Numéro de facture</th>
                            <th style="border: 1px solid #ddd; padding: 10px;">Date de facture</th>
                            <th style="border: 1px solid #ddd; padding: 10px;">Date d'échéance</th>
                            <th style="border: 1px solid #ddd; padding: 10px;">Montant HT</th>
                            <th style="border: 1px solid #ddd; padding: 10px;">Montant TTC</th>

                        </tr>
                    </thead>
                    <tbody>


                        <tr>
                            <td>
                                <t t-esc="doc.partner_id.name"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                <t t-esc="doc.name"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                <t t-esc="doc.invoice_date"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                <t t-esc="doc.invoice_date_due"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                <t t-esc="doc.amount_untaxed"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                <t t-esc="doc.amount_total"/>
                            </td>

                        </tr>


                    </tbody>
                </table>
                    
                    </main>
                </t>
            </div>

        </t>
    </template>


<record id="action_report_selected_invoices" model="ir.actions.report">
    <field name="name">Filtered Invoices</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">lux_contacts_custom_fields.filtered_invoices_report_template</field>
    <field name="report_file">lux_contacts_custom_fields.filtered_invoices_report_template</field>
</record>
</odoo>
