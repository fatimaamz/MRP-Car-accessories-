<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  
  
    <record id="view_account_invoice_report_wizard_form" model="ir.ui.view">
        <field name="name">account.invoice.report.wizard.form</field>
        <field name="model">account.invoice.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Etat des comptes">
                <group>
                    <field name="company_id"/>
                    <field name="partner_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
     <record id="action_account_invoice_report_wizard" model="ir.actions.act_window">
        <field name="name">Etat des comptes</field>
        <field name="res_model">account.invoice.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Accounting -->
    <menuitem id="menu_account_invoice_report_root" name="Etat des comptes" parent="account_accountant.menu_accounting" 
              action="action_account_invoice_report_wizard"/>

   <!--Etat de compte pdf template -->

   <template id="invoice_report_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <main>
                    <h2 style="text-align: center;"><strong>Etat des comptes</strong></h2>
                    <span style="text-align: right; float: right;">Date: <t t-esc="docs[0].date_today"/></span>
                    <p><strong>Client :</strong> <t t-esc="data['partner_id']"/></p>
                    <p><strong>Company :</strong> <t t-esc="data['company_id']"/></p>
                    <p><strong>Période : </strong>du <t t-esc="data['date_start'] or 'N/A'"/> au <t t-esc="data['date_end'] or 'N/A'"/></p>

                    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th>Numéro de facture</th>
                                <th>Commande</th>
                                <th>Date</th>
                                <th>Dealer</th>
                                <th>Ship to</th>
                                <th>N° Tracking</th>
                                <th>Payé le</th>
                                <th>Total $</th>
                            </tr>
                        </thead>
                          <t t-foreach="data['invoices']" t-as="doc">
                            <tbody>
                                <tr>
                                    <td><t t-esc="doc.name"/></td>
                                    <td><t t-esc="doc.invoice_origin"/></td>
                                    <td><t t-esc="doc.invoice_date"/></td>
                                    <td><t t-esc="doc.partner_id.dealer_code"/></td>
                                    <td><t t-esc="doc.partner_shipping_id.name"/></td>
                                    <td><t t-esc="doc.tracking"/></td>
                                    <td><t t-esc="doc.invoice_date_due"/></td>
                                    <td><t t-esc="doc.amount_total"/></td>
                                </tr>
                            </tbody>
                        </t>
                    </table>
                    <div style="float: right; padding: 7px;">
                        <strong>Solde dû / Amount due: $<t t-esc="'%.2f' % sum(docs.mapped('amount_total'))"/></strong>
                    </div>
                </main>
            </div>
        </t>
    </template>

  <record id="action_invoice_report" model="ir.actions.report">
    <field name="name">Customer Invoice Report</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">lux_contacts_custom_fields.invoice_report_template</field>
    <field name="print_report_name">'Etat de compte' + object.partner_id.name</field>
</record>
  
</odoo>
