<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_report_invoice_new_template" model="ir.actions.report">
        <field name="name">Facture/Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lux_contacts_custom_fields.report_invoice_new_template</field>
        <field name="report_file">lux_contacts_custom_fields.report_invoice_new_template</field>
        <field name="print_report_name">"Facture- %s" % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>


    <template id="report_invoice_new_template">


        <t t-call="web.basic_layout">

             

           <div class="page" style="color: #2f374f;font-family: Inter;line-height: 1.3;">
                <t t-foreach="docs" t-as="doc">
                    <main>
                        <div class="header"
                             style="width: 100%; display: flex; justify-content: space-between; align-items: center;">
                            <table style="width: 100%; border: none; padding: 10px 0; border-collapse: collapse;">
                                <tr style="border: 1px solid white;">
                                    <td style="text-align: left; vertical-align: middle; padding-right: 20px; border: 1px solid white;">
                                        <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)"
                                                 style="  width: 250px;height: 60px;" alt="Company Logo"/><br/><br/>
                                        <h2 style="display: inline-block; margin-left: 8px; vertical-align: middle; margin-bottom: 0;">
                                            <strong>Invoice</strong>
                                        </h2>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle; border: 1px solid white;float: right;">
                                        <div style="text-align: justify; width: 100%; border: 1px solid white;">
                                            <strong style="font-size: 16px;">
                                                <t t-esc="user.company_id.name"/>
                                            </strong>
                                            <br/>
                                        <span>
                                               <t t-if="user.company_id.street">
                                            <t t-esc="user.company_id.street"/>
                                            <t t-if="user.company_id.city or user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.city">
                                            <t t-esc="user.company_id.city"/>
                                            <t t-if="user.company_id.state_id or user.company_id.country_id">, </t>
                                        </t>
                                        <t t-if="user.company_id.state_id">
                                            <t t-esc="user.company_id.state_id.name"/>
                                            <t t-if="user.company_id.country_id">, </t>
                                        </t>
                                        <br/>
                                        <t t-if="user.company_id.zip">
                                            <t t-esc="user.company_id.zip"/>
                                        </t>
                                        <t t-if="user.company_id.country_id">
                                            <t t-esc="user.company_id.country_id.name"/>
                                        </t>
                                        </span><br/>
                                            
                                            <span style="font-size: 14px;">
                                                <t t-esc="user.company_id.email or ''"/>
                                                /
                                                <t t-esc="user.company_id.phone or ''"/>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 30px;">
                            <table style="width: 100%; border-spacing: 5; margin-bottom: 10px;">
                                <tr>
                                    <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px;  border: 1px solid white;">
                                        <strong style="font-size: 16px;">
                                            <t t-esc="doc.sale_order_partner_id.name"/>
                                        </strong>
                                        <br/>
                                        <t t-esc="doc.sale_order_partner_id.phone or ''"/>
                                        <br/>
                                        <t t-if="doc.sale_order_partner_id.street">
                                            <t t-esc="doc.sale_order_partner_id.street"/>
                                            <t t-if="doc.sale_order_partner_id.city or doc.sale_order_partner_id.state_id or doc.sale_order_partner_id.country_id">
                                                ,
                                            </t>
                                        </t>
                                        <t t-if="doc.sale_order_partner_id.city">
                                            <t t-esc="doc.sale_order_partner_id.city"/>
                                            <t t-if="doc.sale_order_partner_id.state_id or doc.sale_order_partner_id.country_id">
                                                ,
                                            </t>
                                        </t>
                                        <t t-if="doc.sale_order_partner_id.state_id">
                                            <t t-esc="doc.sale_order_partner_id.state_id.name"/>
                                            <t t-if="doc.sale_order_partner_id.country_id">,</t>
                                        </t>
                                        <br/>
                                        <t t-if="doc.sale_order_partner_id.zip">
                                            <t t-esc="doc.sale_order_partner_id.zip"/>
                                        </t>
                                        <t t-if="doc.sale_order_partner_id.country_id">
                                            <t t-esc="doc.sale_order_partner_id.country_id.name"/>
                                        </t>
                                    </td>

                                    <td style="padding: 10px; border-radius: 15px;
                                              background-color: #f6f8fc;
                                              border: 1px solid white;
                                              height: 160px;
                                              display: flex;
                                              flex-direction: column;
                                            
                                              box-sizing: border-box;
                                             
                                              font-size: 16px;">
                                      
                                        <span>
                                            <strong>
                                                <br/><span t-esc="'Ship to / Expédié à :'"/>
                                            </strong>
                                        </span>
                                        <br/>
                                        <br/>
                                        <t t-if="doc.partner_shipping_id.name">
                                          <strong>  <t t-esc="doc.partner_shipping_id.name" /></strong>
                                            <br/>
                                            <br/>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.street">
                                            <t t-esc="doc.partner_shipping_id.street"/>
                                            <t t-if="doc.partner_shipping_id.city or doc.partner_shipping_id.state_id or doc.partner_shipping_id.zip">
                                                ,
                                            </t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.city">
                                            <t t-esc="doc.partner_shipping_id.city"/>
                                            <t t-if="doc.partner_shipping_id.state_id or doc.partner_shipping_id.zip">
                                                ,
                                            </t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.state_id">
                                            <t t-esc="doc.partner_shipping_id.state_id.name"/>
                                            <t t-if="doc.partner_shipping_id.zip">,</t>
                                        </t>
                                        <t t-if="doc.partner_shipping_id.zip">
                                            <t t-esc="doc.partner_shipping_id.zip"/>
                                        </t>
                                        <br/>
                                        <br/>
                                        <t t-esc="doc.partner_shipping_id.email"/><br/>
                                        <t t-if="doc.partner_shipping_id.phone">
                                            <span>Téléphone :
                                                <t t-esc="doc.partner_shipping_id.phone"/>
                                            </span>
                                        </t>
                                        <br/>
                                        <br/>
                                        <span>Ship Date :
                                            <t t-esc="doc.invoice_date"/>
                                        
                                        </span>
                                        <br/>
                                           
                                            <span>Tracking number : <t t-esc="doc.numero_suivi"/></span>
                                        <br/>
                                           <span>Via :<strong> <t t-esc="doc.carrier_id.name"/></strong></span>
                                    </td>

                                    <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 16px; border: 1px solid white; margin-left: 20px; text-align: justify;">
                                        <strong style="font-size: 14px;">Order Details:</strong>
                                        <br/>
                                        <br/>
                                        Date:
                                        <t t-esc="doc.invoice_date  or ''"/>
                                        <br/>
                                        <br/>
                                        Order N°:
                                        <t t-esc="doc.invoice_origin"/>
                                        <br/>
                                        <br/>
                                        PO Client:
                                        <t t-esc="doc.sale_order_partner_id.po or ''"/>
                                        <br/>
                                        <br/>

                                        Facture N°:
                                        <t t-esc="doc.name or ''"/>
                                         <br/>
                                        <br/>

                                         Payé le: 
                                          <t t-esc="doc.payment_date or ''"/>
                                         <br/>
                                        <br/>
                                        Dealer : <t t-esc="doc.sale_order_partner_id.dealer_code or ''"/>
                                        
                                        
                                    </td>
                                </tr>
                            </table>
                        </div>

                        


                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;font-size: 16px;">
                            <thead>
                                <tr style=" background-color: #f7f7f7;">

                                    <th style="border: 1px solid #ddd; padding: 10px;">Description</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Qty</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Unit Cost</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">Disc.</th>
                                    <th style="border: 1px solid #ddd; padding: 10px;">STotal</th>

                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>


                                        <t t-if="line.name">
                                            <td style="border: 1px solid #ddd; padding: 10px;">
                                              <strong>  <t t-esc="line.name or ''"/></strong>
                                            </td>
                                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                                <t t-esc="line.quantity"/>
                                            </td>
                                            
                                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                                <t t-esc="line.price_unit"/>
                                            </td>
                                            
                                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                                <t t-esc="line.discount"/>
                                            </td>
                                            
                                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center;">
                                                <t t-esc="line.price_subtotal"/>
                                            </td>
                                        </t>
                                    </tr>

                                </t>


                            </tbody>
                        </table>
                        <table style="width: 100%; margin: 28px auto;  border: 1px solid #f7f7f7; background-color: #f7f7f7;">
                        <tr>
                            <td style="text-align: justify; font-size: 14px; padding: 6px;">
                                PCS :
                                <t t-esc="doc.pcs"/>
                            </td>
                            <td style=" font-size: 14px;padding: 6px;float: right;">
                                <strong>Sous Total :</strong>
                                <t t-esc="'$ {:.2f}'.format(doc.amount_untaxed)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: justify; font-size: 14px; padding: 6px;">
                                Carrier :
                                <t t-esc="doc.carrier_id.name"/>
                            </td>
                            <td style=" font-size: 14px;padding: 6px;float: right;">
                                <strong>Transport :</strong>
                                <t t-esc="doc.transport"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: justify; font-size: 14px; padding: 6px;">
                                Custom Clearance :
                                <t t-esc="doc.custom_clearance"/>
                            </td>
                            <td style=" font-size: 14px;padding: 6px;float: right;">
                                <strong>Taxes :</strong>
                                <t t-esc="doc.amount_tax_signed"/>
                            </td>
                        </tr>
                        <tr>
                            <td rowspan="2" style="text-align: justify; font-size: 14px; padding: 6px;">
                                Weight :
                                <t t-esc="doc.weight"/>
                                <br/> 
                              
                               
                            </td>
                           <!-- <td style=" font-size: 14px;padding: 6px;float: right;">
                                <strong>TPS/G.S.T :</strong>
                                <t t-esc="doc.tps"/><br/>
                                <span style="font-size: 9px; padding: 5px;"> (HTS) si applicable </span>
                            </td>-->
                        </tr>
                           <tr>
                               <td rowspan="2" style="text-align: justify; font-size: 14px; padding: 6px;"> Serial Number :
                                <t t-esc="doc.numero_serie"/>
                               </td>
                           </tr> 
                        <tr>
                            <td style="text-align: justify; font-size: 14px; padding: 6px;">
                                
                                Stock :
                                <t t-esc="doc.picking_name"/>
                            </td>
                        
                            
                            <td style="font-size: 14px;float: right;">
                                <strong>GRAND TOTAL :</strong>
                                <t t-esc="'$ {:.2f}'.format(doc.amount_total)"/>
                            </td>
                        </tr>
                       
                    </table>




                        <t t-if="doc.narration">
                            <div style="margin-top: 20px; padding: 10px; font-size: 14px;">
                                <strong>Special note :</strong>
                                <br/>
                                <t t-esc="doc.narration or ''"/>
                            </div>
                        </t>

                    </main>
                </t>
            </div>
            <div class="footer" style="text-align: center; font-size: 12px; margin-top: 20px;">
                <strong>Payment to / payé par:</strong> Luxwood Auto Trim Design Inc
                &#160;&#160;&#160;&#160;
                <strong>HTS:</strong> 8708.99.8080
                &#160;&#160;&#160;&#160;
                <strong>Country of origin:</strong> Canada, Qc
            </div>
        
        </t>
    </template>


</odoo>
