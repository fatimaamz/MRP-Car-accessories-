<odoo>
<template id="sales_team_report_template">
  <t t-call="web.html_container">
    <t t-call="web.external_layout">
      <div class="page">
        <h2>Statistiques Équipe Commerciale (7 derniers jours)</h2>
        <t t-foreach="teams" t-as="team">
          <div class="mt-3 mb-4">
            <h3><t t-esc="team['name']"/></h3>
            <p>Total des ventes : <strong><t t-esc="team['weekly_sales']"/> DH</strong></p>
            <p>Objectif de ventes : <strong><t t-esc="team['weekly_target']"/> DH</strong></p>
            <p>Objectif de facturation : <strong><t t-esc="team['invoicing_target']"/> DH</strong></p>
            <p>Nombre de clients : <strong><t t-esc="team['customer_count']"/></strong></p>

            <!-- Graphique simple -->
            <svg width="500" height="100">
              <rect x="10" y="20" width="5" height="60" fill="transparent"/>
              <rect x="20" y="20" t-att-width="team['weekly_sales'] / 10" height="20" fill="green"/>
              <text x="20" y="15">Ventes</text>

              <rect x="20" y="50" t-att-width="team['weekly_target'] / 10" height="20" fill="orange"/>
              <text x="20" y="45">Objectif</text>
            </svg>
          </div>
        </t>
      </div>
    </t>
  </t>
</template>



     <record id="action_rapport_hybdomadaire" model="ir.actions.report">
        <field name="name">Rapport hybdomadaire</field>
        <field name="model">crm.team</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weekly_sales_report.sales_team_report_template</field>
        <field name="report_file">weekly_sales_report.sales_team_report_template</field>
        <field name="print_report_name">"Rapport hybdomadaire"</field>
        <field name="binding_model_id" ref="sales_team.model_crm_team"/>
    </record>


</odoo>
