<odoo>
<template id="sales_team_report_template">
  <t t-call="web.html_container">
    <t t-call="web.basic_layout">
      <div class="page">
        <h2>Statistiques Équipe Commerciale (7 derniers jours)</h2>
         <t t-foreach="teams" t-as="team">
  <div class="page">
    <h2>Weekly Sales Report — <t t-esc="team['name']"/></h2>

    <!-- Résumé principal -->
    <div>
      <h3>🎯 Objectif vs Réalisé</h3>
      <p>Target : <strong>$<t t-esc="team['weekly_target']"/></strong></p>
      <p>Total Sales : <strong>$<t t-esc="team['weekly_sales']"/></strong></p>

      <!-- Barre de progression -->
      <svg width="400" height="20">
        <rect x="0" y="0" width="400" height="20" fill="#f0f0f0"/>
        <rect x="0" y="0"
              t-att-width="min(400, 400 * (team['weekly_sales'] / team['weekly_target'] if team['weekly_target'] else 0))"
              height="20" fill="#ff6f61"/>
      </svg>
    </div>

    <!-- % objectif atteint -->
    <t t-set="percent" t-value="int((team['weekly_sales'] / team['weekly_target']) * 100 if team['weekly_target'] else 0)"/>
    <p style="color:green;">
      Objectif atteint : <strong><t t-esc="percent"/>%</strong>
    </p>

    <!-- Drop/Ship (Exemple statique) -->
    <h4>Drop/Ship</h4>
    <p>Actual : $940</p>
    <svg width="400" height="15">
      <rect width="940 * 0.04" height="15" fill="#0098c3"/>
    </svg>

    <!-- Nombre de clients -->
    <h4>Clients</h4>
    <p>Lux : <t t-esc="team['customer_count']"/> clients</p>

    <!-- Comparaison année -->
    <h4>Même semaine année précédente</h4>
    <p>This year : $<t t-esc="team['weekly_sales']"/></p>
    <p>Last year : $5023 (exemple)</p>
  </div>
</t>

      </div>
    </t>
  </t>
</template>



     <record id="action_rapport_hybdomadaire" model="ir.actions.report">
        <field name="name">Rapport hybdomadaire</field>
        <field name="model">crm.team</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weekly_sales_report.sales_team_report_template</field>
        <field name="report_file">weekly_sales_report.sales_team_report_template</field>
        <field name="print_report_name">"Rapport hybdomadaire"</field>
        <field name="binding_model_id" ref="sales_team.model_crm_team"/>
    </record>


</odoo>
