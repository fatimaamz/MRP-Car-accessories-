<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view for Shopify Credentials -->
    <record id="view_shopify_credentials_form" model="ir.ui.view">
        <field name="name">shopify.credentials.form</field>
        <field name="model">shopify.credentials</field>
        <field name="arch" type="xml">
            <form string="Shopify Credentials">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="shopify_company_id"/>
                    <field name="api_key"/>
                    <field name="api_secret"/>
                    <field name="shop_url"/>
                    <field name="access_token"/>
                    <field name="last_sync_date" readonly="1"/>
                    <field name="shopify_store_time_zone" readonly="1"/>
                </group>
                <div>
                    <button string="Test connection" type="object" name="shopify_test_connection" class="oe_highlight"/>
                    <button string="Synchroniser les produits" type="object" name="action_sync_products" class="oe_highlight"/>
                </div>
            </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for Shopify Credentials -->
    <record id="view_shopify_credentials_tree" model="ir.ui.view">
        <field name="name">shopify.credentials.tree</field>
        <field name="model">shopify.credentials</field>
        <field name="arch" type="xml">
            <tree string="Shopify Credentials">
                <field name="name"/>
                <field name="shop_url"/>
            </tree>
        </field>
    </record>

    <!-- Action for Shopify Credentials -->
    <record id="action_shopify_credentials" model="ir.actions.act_window">
        <field name="name">Shopify Credentials</field>
        <field name="res_model">shopify.credentials</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
