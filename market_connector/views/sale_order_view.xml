<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action for Orders -->
    <record id="action_shopify_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="view_sale_form_ept" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_cancel" position="after">
                <field invisible="1" name="canceled_in_shopify"/>
                <field invisible="1" name="shopify_instance_id"/>
                <button class="oe_highlight" invisible="state != 'cancel' or canceled_in_shopify == True or shopify_instance_id == False" name="action_open_cancel_wizard" string="Cancel In Shopify" type="object">
                </button>
            </button></field>
    </record>
    <record id="view_order_tree_market_connector" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-danger="state in ('invoice_except','shipping_except')" decoration-info="state in ('waiting_date','manual')" decoration-muted="state=='cancel'" decoration-success="updated_in_shopify==True" sample="1">
                <field decoration-bf="1" name="name" string="Order Number"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field decoration-bf="1" name="amount_total" sum="Total Tax Included" widget="monetary"/>
                <field decoration-info="state == 'draft' or state == 'sent'" decoration-success="state == 'sale' or state == 'done'" name="state" widget="badge"/>
                <field name="updated_in_shopify" readonly="1" widget="boolean_toggle"/>
            </tree></field>
    </record>
    <record id="shopify_view_sales_order_filter" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter domain="[('shopify_order_status', '=', 'fulfilled')]" help="While import order from shopify at time shipped order" name="shopify_order_status" string="Shipped Order"/>
                <filter domain="[('updated_in_shopify', '=', True)]" name="order_status_updated" string="Order status updated in Shopify"/>
                <filter domain="[('updated_in_shopify', '=', False)]" name="order_status_not_updated" string="Order status not updated in Shopify"/>
            </filter></field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <data>
                <notebook position="inside">
                    <page invisible="shopify_instance_id == False" string="Shopify Info">
                        <group>
                            <group>
                                <field name="shopify_order_id" readonly="True"/>
                                <field name="shopify_order_number" readonly="True"/>
                                <field name="shopify_instance_id" options="{'no_create':True,'no_create_edit':True}" readonly="True"/>
                                <field name="shopify_order_status" readonly="True"/>
                            </group>
                        </group>
                        
                    </page>
                </notebook>
            </data></field>
    </record>
    <record id="action_shopify_sale_quotation" model="ir.actions.act_window">
        <field name="name">Shopify Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"not_shopify_order":False}</field>
        <field name="domain">[('shopify_order_id','!=',False),('state','in',('draft','sent','cancel'))]</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="help" type="html">
            <div class="oe_empty_shopify_sale_quotation">
                <br/>
                <br/>
                <br/>
                <p>
                    <b>
                        Aucune offre de vente n'a encore été synchronisée depuis l'une de vos
                        compates Shopify.
                    </b>
                </p>
            </div></field>
    </record>
    <record id="action_shopify_sales_order" model="ir.actions.act_window">
        <field name="name">Shopify Sales Order</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"not_shopify_order":False}</field>
        <field name="domain">[('shopify_order_id','!=',False),('state','in',('sale','done'))]</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="help" type="html">
            <div class="oe_empty_shopify_sale_order">
                <br/>
                <br/>
                <br/>
                <p>
                    <b>
                        Aucune offre de vente n'a encore été synchronisée depuis l'une de vos
                        compates Shopify.
                    </b>
                </p>
            </div></field>
    </record>
    <!--Action of risky quotations-->
    <record id="action_shopify_risky_quotations" model="ir.actions.act_window">
        <field name="name">Risky Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"not_shopify_order":False}</field>
        <field name="domain">[('shopify_order_id','!=',False),('is_risky_order','!=',False)]</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="help" type="html">
            <div class="oe_empty_shopify_sale_quotation">
                <br/>
                <br/>
                <br/>
                <p>
                    <b>
                        Aucune offre de vente n'a encore été synchronisée depuis l'une de vos
                        compates Shopify.
                    </b>
                </p>

            </div></field>
    </record>
    <!--Action of sale quotation-->
    <record id="action_shopify_instance_sale_quotation" model="ir.actions.act_window">
        <field name="name">Shopify Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="domain">[('shopify_order_id','!=',False),('state','in',('draft','sent','cancel')),('shopify_instance_id','=',active_id)]</field>
    </record>
    <!--Action of sale order-->
    <record id="action_shopify_sale_instance_ept" model="ir.actions.act_window">
        <field name="name">Shopify Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="domain">[('shopify_instance_id','=',active_id)]</field>
    </record>
    <!--Action of shopify sale order-->
    <record id="action_shopify_instance_sales_order_only" model="ir.actions.act_window">
        <field name="name">Shopify Sales Order</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="domain">[('shopify_order_id','!=',False),
            ('state','not in',('draft','sent','cancel')),('shopify_instance_id','=',active_id)]</field>
    </record>
    <!--Action of risky quotation-->
    <record id="action_shopify_instance_risky_quotation" model="ir.actions.act_window">
        <field name="name">Shopify Risky Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="view_order_tree_market_connector"/>
        <field name="context">{"not_shopify_order":False}</field>
        <field name="domain">[('shopify_order_id','!=',False),('state','=','draft'),('is_risky_order','!=',False),('shopify_instance_id','=',active_id)]</field>
    </record>

    </odoo>
