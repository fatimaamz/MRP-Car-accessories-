<odoo>
    <!-- Vue Liste -->
    <record id="action_shopify_queue_product_tree" model="ir.ui.view">
        <field name="name">merket.connector.products.data.queue.tree</field>
        <field name="model">merket.connector.products.data.queue</field>
        <field name="arch" type="xml">
            <tree string="Shopify Credentials">
                <field name="shopify_id"/>
                <field name="shopify_title"/>
                <field name="shopify_name"/>
                <field name="brand"/>
                <field name="style"/>
                <field name="model"/>
                <field name="is_match_name" readonly="1"/>
                <field name="is_match_brand" readonly="1"/>
                <field name="is_match_style" readonly="1"/>
                <field name="is_match_model" readonly="1"/>
                <field name="product_id"/>
                <button name="check_matching_action" string="Check Matching" type="object" class="oe_highlight"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_form_shopify_queue_product" model="ir.ui.view">
        <field name="name">merket.connector.products.data.queue.form</field>
        <field name="model">merket.connector.products.data.queue</field>
        <field name="arch" type="xml">
            <form string="Shopify Product Data Queue">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="is_process_queue" readonly="1"/>
                        <field name="shopify_id" readonly="1"/>
                        <field name="shopify_title" readonly="1"/>
                        <field name="shopify_name" readonly="1"/>
                        <field name="brand" readonly="1"/>
                        <field name="style" readonly="1"/>
                        <field name="model" readonly="1"/>
                        <field name="shopify_attribute" readonly="1"/>
                        <field name="shopify_reference" readonly="1"/>
                        <field name="shopify_years" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="shopify_instance_id" readonly="1"/>
                        <field name="is_match_name" readonly="1"/>
                        <field name="is_match_brand" readonly="1"/>
                        <field name="is_match_style" readonly="1"/>
                        <field name="is_match_model" readonly="1"/>
                        <field name="result" readonly="1"/>
                    </group>
                    <group>
                        <button name="check_matching_action" type="object" string="Check Matching" class="oe_highlight"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shopify_queue_product" model="ir.actions.act_window">
        <field name="name">Queue Product</field>
        <field name="res_model">merket.connector.products.data.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="action_shopify_queue_product_tree"/>
    </record>
</odoo>
