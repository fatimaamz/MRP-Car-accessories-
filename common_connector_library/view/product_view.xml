<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_form_view_common_vendor_stock_ept" model="ir.ui.view">
        <field name="name">Common Vendor Stock Ept</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Images">
                    <group colspan="4" string="Images Info">
                        <field context="{'default_name': name,'default_product_id':id,'default_template_id':product_tmpl_id}" mode="kanban" name="ept_image_ids" nolabel="1" options="{'create_text':'Add a Media'}"></field>
                    </group>
                </page>
            </xpath></field>
    </record>
</odoo>
