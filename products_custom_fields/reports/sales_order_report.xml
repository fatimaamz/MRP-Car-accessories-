<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nouveau Template pour le rapport -->
    <template id="report_saleorder_new_design">
        
            <t t-set="doc" t-value="doc"/>

            <!-- Ensure content is inside a valid <main> or appropriate structure -->
            <main style="width: 100%; padding: 10px;">

                <!-- Header Section -->
                <div class="header" style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding: 10px 0; flex-direction: row-reverse;">
                    <!-- Company Details (now on the left) -->
                    <div style="text-align: left; font-size: 14px;">
                        <strong style="font-size: 16px;">
                            <t t-esc="user.company_id.name"/>
                        </strong><br/>
                        <span><t t-esc="user.company_id.email or ''"/> / <t t-esc="user.company_id.phone or ''"/></span><br/>
                    </div>
                
                    <!-- Logo and Title (now on the right) -->
                    <div style="text-align: right;">
                        <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)" style="height: 60px;" alt="Company Logo"/>
                        <h2>Sales Order</h2>
                    </div>
                </div>

                <!-- Content Section (order details) -->
                <t t-foreach="docs" t-as="doc">
                   <div style="margin-top: 20px;">
                        <table style="width: 100%; border-spacing: 0; margin-bottom: 10px;">
                            <tr>
                                <!-- Left Block: Customer Information -->
                                <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px;">
                                    <strong style="font-size: 16px;">
                                        <t t-esc="doc.partner_id.name"/>
                                    </strong><br/>
                                    <t t-esc="doc.partner_id.phone or ''"/><br/>
                                    <t t-esc="doc.partner_id.street or ''"/>, 
                                    <t t-esc="doc.partner_id.city or ''"/>, 
                                    <t t-esc="doc.partner_id.state_id.name or ''"/><br/>
                                    <t t-esc="doc.partner_id.zip or ''"/> 
                                    <t t-esc="doc.partner_id.country_id.name or ''"/>
                                </td>
                    
                                <!-- Center Block: Ship To -->
                                <td style="padding: 10px; background-color: #f9fbff; border-radius: 10px; border: 1px solid #ddd; vertical-align: top; width: 40%; font-size: 14px;">
                                    <strong style="font-size: 16px;">Ship to / Expédié à :</strong><br/>
                                    <t t-esc="doc.partner_shipping_id.name or ''" style="font-weight: bold;"/><br/>
                                    <t t-esc="doc.partner_shipping_id.street or ''"/><br/>
                                    <t t-esc="doc.partner_shipping_id.city or ''"/>, 
                                    <t t-esc="doc.partner_shipping_id.state_id.name or ''"/>, 
                                    <t t-esc="doc.partner_shipping_id.zip or ''"/><br/>
                                    <t t-esc="doc.partner_shipping_id.country_id.name or ''"/><br/>
                                    <span style="font-size: 13px;">Téléphone : 
                                        <t t-esc="doc.partner_shipping_id.phone or ''"/>
                                    </span><br/>
                                    <span>Ship Date : 
                                        <t t-esc="doc.commitment_date or ''"/>
                                    </span>
                                </td>
                    
                                <!-- Right Block: Order Details -->
                                <td style="padding: 10px; vertical-align: top; width: 30%; font-size: 14px;">
                                    <strong style="font-size: 16px;">Order Details:</strong><br/>
                                    Date: <t t-esc="format_date(doc.date_order)"/><br/>
                                    Order N°: <t t-esc="doc.name"/><br/>
                                    PO Client: <t t-esc="doc.client_order_ref or ''"/><br/>
                                    Facture N°: <t t-esc="doc.invoice_ids[0].name or ''"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>

               
            </main>

        
    </template>

    <!-- Register the report -->
    <record id="action_report_saleorder_new_design" model="ir.actions.report">
        <field name="name">Sales Order (New Design)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">products_custom_fields.report_saleorder_new_design</field>
        <field name="report_file">products_custom_fields.report_saleorder_new_design</field>
        <field name="print_report_name">'Sales Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
    </record>

</odoo>
