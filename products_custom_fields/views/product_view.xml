<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group>
                <field name="price_line_ids">
                    <tree>
                        <field name="customer_type_id"/>
                        <field name="price"/>
                        <field name="intitule"/>
                        
                    </tree>
                </field>
            </group>
                <group string="Détails">
                    <group>
                        <field name="year_ids" widget="many2many_tags"/>

                        <field name="priceA"/>
                        <field name="priceB"/>

                        <field name="priceC"/>
                        <field name="priceD"/>
                    </group>
                    <group>
                        <field name="product_type"/>
                        <field name="modele_id"/>
                        <field name="sous_model_id"/>
                        <field name="style_id"/>
                        <field name="marque_id"/>
                    </group>
                </group>
            </xpath>

           
        </field>
    </record>


    <record id="view_product_style_tree" model="ir.ui.view">
        <field name="name">product.style.tree</field>
        <field name="model">product.style</field>
        <field name="arch" type="xml">
            <tree string="Styles" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_product_modele_tree" model="ir.ui.view">
        <field name="name">product.modele.tree</field>
        <field name="model">product.modele</field>
        <field name="arch" type="xml">
            <tree string="Modèles" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_product_marque_tree" model="ir.ui.view">
        <field name="name">product.marque.tree</field>
        <field name="model">product.marque</field>
        <field name="arch" type="xml">
            <tree string="Marques" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_product_sousmodele_tree" model="ir.ui.view">
        <field name="name">product.sousmodele.tree</field>
        <field name="model">product.sousmodele</field>
        <field name="arch" type="xml">
            <tree string="Sous Modèles" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_year_model_tree" model="ir.ui.view">
        <field name="name">year.model.tree</field>
        <field name="model">year.model</field>
        <field name="arch" type="xml">
            <tree string="Années" editable="bottom" sample="1">
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_style_view" model="ir.actions.act_window">
        <field name="name">Styles</field>
        <field name="res_model">product.style</field>
        <field name="view_mode">tree</field>
    </record>
    <record id="action_year_view" model="ir.actions.act_window">
        <field name="name">Années</field>
        <field name="res_model">year.model</field>
        <field name="view_mode">tree</field>
    </record>
      <record id="action_marque_view" model="ir.actions.act_window">
        <field name="name">Marques</field>
        <field name="res_model">product.marque</field>
        <field name="view_mode">tree</field>
    </record>
    <record id="action_modele_view" model="ir.actions.act_window">
        <field name="name">Modèles</field>
        <field name="res_model">product.modele</field>
        <field name="view_mode">tree</field>
    </record>
    <record id="action_sous_modele_view" model="ir.actions.act_window">
        <field name="name">Modèles</field>
        <field name="res_model">product.sousmodele</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_action_styles_configuration_view" name="Styles" parent="sale.menu_sale_config" sequence="11"
              action="action_style_view"/>
    <menuitem id="menu_action_modele_configuration_view" name="Modèles" parent="sale.menu_sale_config" sequence="12"
              action="action_modele_view"/>
    <menuitem id="menu_action_sous_modele_configuration_view" name="Sous Modèles" parent="sale.menu_sale_config"
              sequence="13" action="action_sous_modele_view"/>
    <menuitem id="menu_action_marque_configuration_view" name="Marques" parent="sale.menu_sale_config"
              sequence="13" action="action_marque_view"/>
    <menuitem id="menu_action_annes_configuration_view" name="Années" parent="sale.menu_sale_config"
              sequence="13" action="action_year_view"/>

</odoo>
