<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_customized" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                <div class="row">
                    <div class="col-6 text-right">
                        <strong>Facture/Invoice: </strong><span t-field="o.name"/><br/>
                        <strong>Date: </strong><span t-field="o.invoice_date" t-options='{"widget": "date"}'/><br/>
                        <strong>Ref: </strong><span t-field="o.ref"/><br/>
                        <strong>Client PO#: </strong><span t-field="o.invoice_origin"/><br/>
                        <strong>Payé le /Paid on: </strong><span t-field="o.invoice_date" t-options='{"widget": "date"}'/><br/>
                        <strong>Chéque#: </strong><span t-field="o.payment_reference"/><br/>
                        <strong>Invoice Discount: </strong><span t-field="o.invoice_line_id[0].discount"/> <span t-esc="first_discount"/>%
                       
                        <br/>
                    </div>
                </div>
                <div class="row">
                    <h2>Facture/Invoice</h2>
                    <div class="col-6 text-right">
                        <t t-set="information_block">
                            <div name="soldaddress_block">
                                <strong>Sold to/Vendu à:</strong>
                                <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'email'], 'no_marker': True}"/>
                            </div>
                        </t>
                    </div>
                    <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                        <div class="col-6 text-right">
                            <t t-set="information_block">
                                <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                    <strong>Ship to / Expédié a:</strong>
                                    <div t-field="o.partner_shipping_id" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="offset-col-6 col-6" name="no_shipping">
                            <t t-set="address">
                                <address class="mb-0" t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
                                <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                <div class="mt-5 clearfix">
                    <div class="page mb-4">
                        <div class="oe_structure"/>
                        <div id="informations" class="row mt-3 mb-1">
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date" name="invoice_date">
                                <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date:</strong></t>
                                <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>
                                <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date:</strong></t>
                                <t t-else=""><strong>Date:</strong></t><br/>
                                <span t-field="o.invoice_date"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                <strong>Due Date:</strong><br/>
                                <span t-field="o.invoice_date_due"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.delivery_date" name="delivery_date">
                                <strong>Delivery Date:</strong><br/>
                                <span t-field="o.delivery_date"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_origin" name="origin">
                                <strong>Source:</strong><br/>
                                <span t-field="o.invoice_origin"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.partner_id.ref" name="customer_code">
                                <strong>Customer Code:</strong><br/>
                                <span t-field="o.partner_id.ref"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.ref" name="reference">
                                <strong>Reference:</strong><br/>
                                <span t-field="o.ref"/>
                            </div>
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_incoterm_id" name="incoterm_id">
                                <strong>Incoterm:</strong><br/>
                                <p t-if="o.incoterm_location">
                                    <span t-field="o.invoice_incoterm_id.code"/><br/>
                                    <span t-field="o.incoterm_location"/>
                                </p>
                                <span t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                            </div>
                        </div>
                        <div style="overflow: hidden; width: 100%;">
                            <div style="float: left; width: 50%;">
                                TVQ/GST: 1218568986TQ0001
                            </div>
                            <div style="float: right; width: 50%; text-align: right;">
                                TPS/PST: 831575881RT0001
                            </div>
                        </div>
                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                        <div class="oe_structure"/>
                        <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-start"><span>Description</span></th>
                                    <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                    <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                                    <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span>Disc.%</span>
                                    </th>
                                    <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                    <th name="th_subtotal" class="text-end">
                                        <span>Amount</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="current_total" t-value="0"/>
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                    <t t-set="current_total" t-value="current_total + line.price_total"/>
                                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'bg-200 o_line_note' if line.display_type == 'line_note' else 'o_account_invoice_line'">
                                        <td t-if="line.display_type" t-att-colspan="5 if not display_discount else 6" class="text-start">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td t-if="not line.display_type" class="text-start">
                                            <span t-field="line.name"/><br/>
                                            <span t-if="line.product_id" class="text-muted">
                                                <small>
                                                    <span t-field="line.product_id.default_code"/>
                                                </small>
                                            </span>
                                        </td>
                                        <td t-if="not line.display_type" class="text-end">
                                            <span t-field="line.quantity" t-options="{'widget': 'float', 'precision_digits': line.currency_id.decimal_places}"/>
                                            <t t-esc="line.product_uom_id.display_name"/>
                                        </td>
                                        <td t-if="not line.display_type" class="text-end d-none d-md-table-cell">
                                            <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td t-if="not line.display_type and display_discount" class="text-end d-none d-md-table-cell">
                                            <span t-if="line.discount" t-field="line.discount" t-options="{'widget': 'float', 'precision_digits': 2}"/>
                                            <span t-if="not line.discount">0.00</span>
                                        </td>
                                        <td t-if="not line.display_type" class="text-start d-none d-md-table-cell">
                                            <t t-set="taxes" t-value="line.tax_ids.sorted(lambda tax: tax.sequence)"/>
                                            <t t-foreach="taxes" t-as="tax">
                                                <small t-esc="tax.name"/>
                                                <br/>
                                            </t>
                                        </td>
                                        <td t-if="not line.display_type" class="text-end">
                                            <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-if="o.invoice_line_ids and (o.amount_total - current_total) >= 0.001">
                            <t t-set="amount_untaxed" t-value="o.amount_untaxed"/>
                            <t t-set="amount_total" t-value="o.amount_total"/>
                            <t t-set="amount_total" t-value="o.amount_total"/>
                            <t t-set="amount_tax" t-value="amount_total - amount_untaxed"/>
                        </t>
                        <div class="row mt32" name="total_block">
                            <div class="col-6">
                                <t t-set="totals">
                                    <div class="mt-3 oe_structure"/>
                                </t>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tbody>
                                        <tr class="border-black">
                                            <td class="text-start">
                                                <strong>Subtotal</strong>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="o.tax_totals_json['groups_by_subtotal'].items()" t-as="tax_group">
                                            <t t-foreach="tax_group[1]" t-as="tax_line">
                                                <tr>
                                                    <td class="text-start">
                                                        <strong t-esc="tax_line['name']"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="tax_line['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <tr class="border-black">
                                            <td class="text-start">
                                                <strong>Total</strong>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <t t-if="o.narration">
                        <div class="row mt32">
                            <div class="col-12">
                                <h6>Note:</h6>
                                <p t-raw="o.narration"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
