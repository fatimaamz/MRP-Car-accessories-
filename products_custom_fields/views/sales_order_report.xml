<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nouveau Template pour le rapport -->
    <template id="report_saleorder_new_design">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc"/>
            
            <div class="header" style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding: 10px 0;">
                <!-- Logo et Titre -->
                <div>
                    <img t-att-src="'/web/image/res.company/%s/logo' % (user.company_id.id)" style="height: 60px;" alt="Company Logo"/><br/>
                    <h1>Sales Order</h1>
                </div>
                <!-- Détails de la société -->
                <div style="text-align: right; font-size: 14px;">
                    <strong style="font-size: 16px;">
                        <t t-esc="user.company_id.name"/>
                    </strong><br/>
                    <span><t t-esc="user.company_id.email or ''"/> / <t t-esc="user.company_id.phone or ''"/></span><br/>
                </div>
            </div>
            <!-- Contenu du Document (existant) -->
            <t t-foreach="docs" t-as="doc">
                <div class="mt16">
                    <strong>Order Reference:</strong> <t t-esc="doc.name"/>
                    <!-- Ajoutez ici les champs supplémentaires si nécessaire -->
                </div>
            </t>
        </t>
    </template>

    <!-- Déclaration du Rapport -->
    <report
        id="action_report_saleorder_new_design"
        string="Sales Order (New Design)"
        model="sale.order"
        report_type="qweb-pdf"
        name="products_custom_fields.report_saleorder_new_design"
        file="products_custom_fields.report_saleorder_new_design"
        print_report_name="'Sales Order - %s' % (object.name)"
    />
</odoo>
