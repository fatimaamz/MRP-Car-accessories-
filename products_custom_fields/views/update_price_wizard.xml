<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_price_update_wizard_form" model="ir.ui.view">
        <field name="name">price.update.wizard.form</field>
        <field name="model">price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Prices">
                <group>
                    <field name="customer_type_id"/>
                    <field name="price_type_id"/>
                    <field name="value"/>
                </group>
                <footer>
                    <button string="Update Prices" type="object" name="update_prices" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_price_update_wizard" model="ir.actions.act_window">
        <field name="name">Mettre à jour le prix</field>
        <field name="res_model">price.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_price_update_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_price_update_wizard"
              name="Mettre à jour le prix"
              parent="sale.product_menu_catalog"
              action="action_price_update_wizard"
              sequence="30"/>
</odoo>
